import { Button, ScrollView, ListView, Slider, CheckBox, AboutSlint, ComboBox, LineEdit } from "std-widgets.slint";
import { BrowserItem, BrowserRow } from "browser-item.slint";
export { BrowserRow }
import { TrackItem, TrackRow } from "track-item.slint";
export { TrackRow }
import { TransportSeek } from "transport-seek.slint";
import { ConnectionIndicator, ConnectionKind } from "connection-indicator.slint";
export { ConnectionKind }
export component PlayerWindow inherits Window {
    in property <ConnectionKind> connection-kind;
    icon: @image-url("../../../assets/macos/trash-amp.png");
    in property <[string]> sources;
    in-out property <int> source-index;
    callback source-changed(int);
    in-out property <bool> lists-open;
    in-out property <int> settings-tab;
    in-out property <string> server-url;
    in-out property <string> certificate-path;
    in property <string> connection-status;
    in property <bool> collector-active;
    in property <bool> collector-online;
    in property <bool> collector-busy;
    in property <bool> removing-connection;
    in property <[string]> collections;
    in-out property <int> collection-index;
    callback collection-changed(int);
    in property <[string]> saved-lists;
    in-out property <int> list-index: -1;
    callback list-selected(int);
    in property <[BrowserRow]> list-rows;
    in-out property <int> list-entry: -1;
    in property <bool> list-editable;
    in-out property <string> list-name;
    in-out property <string> download-budget: "10";
    in property <image> album-art;
    in property <[string]> album-sources;
    in-out property <int> album-source-index;
    in property <bool> album-ambiguous;
    callback album-source-selected(int);
    callback connect-server(); callback cancel-connect(); callback refresh-server(); callback remove-server();
    callback list-command(int); callback play-list(bool); callback download-action(int); callback save-budget();
    title: "Trash Amp";
    in property <string> application-version;
    preferred-width: 980px; preferred-height: 680px; min-width: 330px; min-height: 230px; max-width: 10000px; max-height: 10000px;
    background: #20262d;
    default-font-family: "Helvetica Neue";
    default-font-size: 14px * root.text-scale;
    in-out property <float> text-scale: 1;
    in property <[TrackRow]> tracks;
    in property <[string]> queued;
    in property <string> album-title: "Your albums, close at hand.";
    in property <string> album-artist: "Open a music folder to begin.";
    in property <string> now-title: "Nothing playing";
    in property <string> now-artist;
    in property <string> status: "Choose a folder, including a mounted network drive.";
    in property <string> elapsed: "0:00";
    in property <string> duration: "0:00";
    in property <bool> playing;
    in-out property <float> progress;
    out property <bool> scrubbing: playhead.scrubbing;
    in property <float> level;
    in property <bool> scanning;
    in property <float> scan-progress;
    in property <[BrowserRow]> browser-rows;
    in property <[BrowserRow]> artist-rows;
    in property <bool> artist-view;
    in property <bool> can-back;
    in property <bool> section-open;
    in property <int> browser-selected: -1;
    in-out property <length> browser-y;
    in-out property <length> detail-y;
    in-out property <length> track-y;
    in-out property <string> search-text;
    in-out property <bool> search-editing;
    in-out property <bool> focus-search;
    callback search-changed();
    callback focus-search-requested();
    callback browse-action(bool, int, int);
    callback open-artist(string);
    callback back();
    callback activate-selection();
    callback album-track-selected();
    in-out property <int> sort-order;
    callback sort-changed();
    in-out property <int> selected-track: -1;
    in property <int> selected-album: -1;
    in property <int> active-track: -1;
    in-out property <bool> reduced-motion;
    in-out property <bool> prefer-raw: true;
    in-out property <bool> automatic-metadata: true;
    in-out property <bool> settings;
    in-out property <bool> show-library: true;
    in-out property <bool> show-queue;
    // Store the desktop choice independently of the temporary phone layout.
    in-out property <float> library-width: 280;
    // Snapshot the viewport to keep layout constraints independent of Window's layout hints.
    private property <length> viewport-width: 980px;
    changed width => { root.viewport-width = self.width; }
    private property <length> desktop-library-width: min(max(220px * root.text-scale, root.library-width * root.text-scale * 1px), root.viewport-width * 0.45);
    in property <bool> wide: true;
    in property <bool> short: false;
    changed short => { if root.short { root.search-editing = false; } }
    changed settings => { if root.settings { root.search-editing = false; root.lists-open = false; } }
    changed lists-open => { if root.lists-open { root.search-editing = false; root.settings = false; } }
    changed show-library => { if !root.show-library && !root.wide { root.search-editing = false; } }
    changed wide => { if !root.wide && !root.show-library { root.search-editing = false; } }
    callback open-folder(); callback demo();
    in property <[string]> folder-libraries;
    in-out property <int> folder-index: -1;
    callback folder-selected(int);
    callback refresh-folder();
    callback play-track(int); callback enqueue(int); callback toggle-play();
    callback previous(); callback next(); callback seek(float);
    callback preferences-changed(); callback clear-queue();
    forward-focus: keyboard;
    keyboard := FocusScope {
      width: 100%; height: 100%;
      key-pressed(event) => {
        if ((event.modifiers.control || event.modifiers.meta) && (event.text == "f" || event.text == "F")) {
            root.focus-search-requested(); return accept;
        }
        if (root.search-editing) { return reject; }
        if (!root.settings && !root.lists-open && !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta) {
            if (event.text == " ") { root.toggle-play(); return accept; }
            if (event.text == Key.LeftArrow) { root.previous(); return accept; }
            if (event.text == Key.RightArrow) { root.next(); return accept; }
        }
        if (event.text == Key.Escape && (root.settings || root.lists-open)) { root.settings = false; root.lists-open = false; keyboard.focus(); return accept; }
        if (event.text == Key.Return && !root.settings && !root.lists-open) { root.activate-selection(); return accept; }
        return reject;
      }
      VerticalLayout {
        padding: 16px; spacing: 8px;
        HorizontalLayout {
            height: 32px; spacing: 6px;
            if root.wide: ComboBox { model: root.sources; current-index <=> root.source-index; accessible-label: "Music source"; horizontal-stretch: 1; selected(i) => { root.source-changed(self.current-index); } }
            if root.wide && root.collector-active && !root.settings: ComboBox { model: root.collections; current-index <=> root.collection-index; accessible-label: "Music collection"; horizontal-stretch: 1; selected(i) => { root.collection-changed(self.current-index); } }
            if root.wide && root.collector-active && !root.settings: Button { text: "Refresh"; enabled: !root.collector-busy; clicked => { root.refresh-server(); } }
            if !root.wide: Text { text: root.settings ? "Settings" : root.lists-open ? "Lists" : "trash amp"; color: #dce5ed; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Button { text: "Open folder"; clicked => { root.open-folder(); } }
            Button { text: root.lists-open ? "Library" : "Lists"; enabled: root.collector-active || root.lists-open; clicked => { root.settings = false; root.lists-open = !root.lists-open; keyboard.focus(); } }
            Button { text: root.settings ? "Done" : "Settings"; clicked => { root.lists-open = false; root.settings = !root.settings; keyboard.focus(); } }
        }
        if !root.wide && !root.settings: VerticalLayout {
            spacing: 4px;
            ComboBox { model: root.sources; current-index <=> root.source-index; accessible-label: "Music source"; selected(i) => { root.source-changed(self.current-index); } }
            if root.collector-active: HorizontalLayout {
                ComboBox { model: root.collections; current-index <=> root.collection-index; accessible-label: "Music collection"; selected(i) => { root.collection-changed(self.current-index); } }
                Button { text: "Refresh"; enabled: !root.collector-busy; clicked => { root.refresh-server(); } }
            }
        }
        if !root.collector-active && !root.settings && !root.lists-open && root.folder-libraries.length > 0: HorizontalLayout {
            height: 32px; spacing: 6px;
            ComboBox { model: root.folder-libraries; current-index <=> root.folder-index; accessible-label: "Saved folder library"; horizontal-stretch: 1;
                selected(i) => { root.folder-selected(self.current-index); } }
            Button { text: "Refresh folder"; enabled: root.folder-index >= 0 && !root.scanning;
                clicked => { root.refresh-folder(); } }
        }
        if root.lists-open: Rectangle {
            background: #283039; border-radius: 6px;
            collector-scroll := ScrollView {
                width: 100%; height: 100%;
                viewport-width: max(self.visible-width, collector-content.min-width);
                viewport-height: max(self.visible-height, collector-content.min-height);
                collector-content := VerticalLayout {
                width: collector-scroll.viewport-width; height: collector-scroll.viewport-height;
                padding: 12px; spacing: 8px;
                Text { text: "Lists"; color: #edf3f8; font-size: 20px * root.text-scale; font-weight: 600; }
                Text { text: root.connection-status; color: #a9bac9; wrap: word-wrap; }
                HorizontalLayout {
                    ComboBox { model: root.saved-lists; current-index <=> root.list-index; selected(i) => { root.list-selected(self.current-index); } }
                    Button { text: "Play"; enabled: root.list-index > 0; clicked => { root.play-list(false); } }
                    Button { text: "Shuffle"; enabled: root.list-index > 0; clicked => { root.play-list(true); } }
                    Button { text: "Download list"; enabled: !root.collector-busy && root.collector-online && root.list-index > 0; clicked => { root.download-action(2); } }
                    Button { text: "Remove list downloads"; enabled: root.list-index > 0; clicked => { root.download-action(3); } }
                }
                HorizontalLayout {
                    LineEdit { text <=> root.list-name; placeholder-text: "List name"; accessible-label: "List name"; }
                    Button { text: "Create"; enabled: !root.collector-busy && root.collector-online && root.list-editable; clicked => { root.list-command(0); } }
                    Button { text: "Rename"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-index > 0; clicked => { root.list-command(1); } }
                    Button { text: "Delete"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-index > 0; clicked => { root.list-command(2); } }
                }
                HorizontalLayout {
                    Button { text: "Append album"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.selected-album >= 0; clicked => { root.list-command(3); } }
                    Button { text: "Append disc"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.selected-album >= 0; clicked => { root.list-command(10); } }
                    Button { text: "Append track"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.selected-track >= 0; clicked => { root.list-command(4); } }
                    Button { text: "Remove entry"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-entry >= 0; clicked => { root.list-command(5); } }
                    Button { text: "Move up"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-entry > 0; clicked => { root.list-command(6); } }
                    Button { text: "Move down"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-entry >= 0; clicked => { root.list-command(7); } }
                }
                HorizontalLayout {
                    Button { text: "Retry original changes"; enabled: !root.collector-busy && root.collector-online; clicked => { root.list-command(8); } }
                    Button { text: "Discard unresolved changes"; clicked => { root.list-command(9); } }
                }
                ListView {
                    min-height: 180px; vertical-stretch: 1;
                    for item[i] in root.list-rows: BrowserItem { item: item; selected: i == root.list-entry;
                        activate => { root.list-entry = i; } pointer-activate => { root.list-entry = i; }
                    }
                }
            }
            }
        }
        if root.settings: Rectangle {
            background: #303942; border-radius: 8px;
            settings-scroll := ScrollView {
                width: 100%; height: 100%;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, settings-content.min-height);
                settings-content := VerticalLayout {
                    width: settings-scroll.visible-width;
                    height: settings-scroll.viewport-height;
                    padding: 12px; spacing: 12px;
                    Text { text: "Settings"; color: #edf3f8; font-size: 20px * root.text-scale; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "General"; enabled: root.settings-tab != 0; clicked => { root.settings-tab = 0; } }
                        Button { text: "Servers"; enabled: root.settings-tab != 1; clicked => { root.settings-tab = 1; } }
                        Button { text: "Downloads"; enabled: root.settings-tab != 2; clicked => { root.settings-tab = 2; } }
                    }
                    if root.settings-tab == 0: VerticalLayout {
                        spacing: 12px;
                        CheckBox { text: "Prefer redumper raw dumps"; checked <=> root.prefer-raw;
                            toggled => { root.preferences-changed(); } }
                        CheckBox { text: "Automatic metadata from MusicBrainz"; checked <=> root.automatic-metadata;
                            toggled => { root.preferences-changed(); } }
                        CheckBox { text: "Reduce motion"; checked <=> root.reduced-motion;
                            toggled => { root.preferences-changed(); } }
                        Button { text: "Load 2,000-album layout demo"; clicked => { root.demo(); root.settings = false; } }
                        HorizontalLayout {
                            Text { text: "Text size"; color: #dce5ed; }
                            Slider { minimum: 1; maximum: 1.6; value: root.text-scale;
                                changed(v) => { root.text-scale = v; root.preferences-changed(); } }
                        }
                    }
                    if root.settings-tab == 1: VerticalLayout {
                        spacing: 10px;
                        Text { text: "Servers"; color: #edf3f8; font-weight: 600; }
                        ComboBox { model: root.sources; current-index <=> root.source-index; accessible-label: "Server to manage"; selected(i) => { root.source-changed(self.current-index); } }
                        LineEdit { text <=> root.server-url; placeholder-text: "https://collector.example:8443"; accessible-label: "Collector server URL"; }
                        HorizontalLayout {
                            Button { text: "Connect / Reconnect"; enabled: !root.collector-busy; clicked => { root.connect-server(); } }
                            Button { text: "Cancel"; enabled: root.collector-busy; clicked => { root.cancel-connect(); } }
                        }
                        LineEdit { text <=> root.certificate-path; placeholder-text: "Optional owner-provided PEM or pairing JSON path"; accessible-label: "Owner-provided trust file"; }
                        Text { text: root.connection-status; color: #dce5ed; wrap: word-wrap; }
                        Button { text: root.removing-connection ? "Removing connection…" : "Remove connection"; enabled: root.collector-active && !root.collector-busy && !root.removing-connection; clicked => { root.remove-server(); } }
                    }
                    if root.settings-tab == 2: VerticalLayout {
                        spacing: 10px;
                        Text { text: "Downloads"; color: #edf3f8; font-weight: 600; }
                        Text { text: "Audio storage limit (GiB)"; color: #a9bac9; }
                        HorizontalLayout {
                            LineEdit { text <=> root.download-budget; placeholder-text: "Audio budget (GiB)"; accessible-label: "Download budget in GiB"; }
                            Button { text: "Set GiB limit"; clicked => { root.save-budget(); } }
                        }
                        HorizontalLayout {
                            Button { text: "Retry downloads"; clicked => { root.download-action(4); } }
                            Button { text: "Cancel downloads"; clicked => { root.download-action(5); } }
                        }
                        Text { text: root.connection-status; color: #a9bac9; wrap: word-wrap; }
                    }
                    Rectangle { min-height: 12px; vertical-stretch: 1; }
                    if root.settings-tab == 0: HorizontalLayout {
                        alignment: center;
                        AboutSlint { width: 240px; height: 112px; }
                    }
                    if root.settings-tab == 0: Text { text: "Trash Amp " + root.application-version; color: #a9bac9; horizontal-alignment: center; }
                }
            }
        }
        if !root.short && !root.settings && !root.lists-open: HorizontalLayout {
            spacing: 0px;
            if root.wide || root.show-library: Rectangle {
                accessible-role: groupbox;
                accessible-label: "Album browser";
                preferred-width: root.wide ? root.desktop-library-width : 280px;
                max-width: root.wide ? root.desktop-library-width : 10000px;
                min-width: root.wide ? root.desktop-library-width : 0px;
                horizontal-stretch: root.wide ? 0 : 1;
                background: #283039; border-radius: 6px;
                HorizontalLayout {
                    x: 8px; y: 8px; width: parent.width - 16px; height: 32px;
                    ComboBox { model: ["Albums", "Artists"]; current-index <=> root.sort-order; selected(_) => { root.sort-changed(); } }
                    if root.section-open: Button { text: "Back"; clicked => { root.back(); keyboard.focus(); } }
                }
                search-bar := HorizontalLayout {
                    x: 8px; y: root.wide ? 46px : parent.height - self.height - 8px;
                    width: parent.width - 16px; height: 36px * root.text-scale; spacing: 4px;
                    search := LineEdit {
                        in-out property <bool> request-focus <=> root.focus-search;
                        changed request-focus => { if self.request-focus { self.focus(); self.request-focus = false; } }
                        init => { if self.request-focus { self.focus(); self.request-focus = false; } }
                        changed has-focus => { root.search-editing = self.has-focus; }
                        placeholder-text: "Search library"; accessible-label: "Search library";
                        text <=> root.search-text;
                        edited(_) => { root.search-changed(); }
                        key-pressed(event) => {
                            if event.text == Key.Escape { keyboard.focus(); return accept; }
                            return reject;
                        }
                    }
                    if root.search-text != "": Button { text: "×"; accessible-label: "Clear search"; max-width: 32px;
                        clicked => { root.search-text = ""; root.search-changed(); search.focus(); } }
                }
                list := ListView {
                    x: 8px; y: root.wide ? 52px + search-bar.height : 46px;
                    width: parent.width - 16px;
                    height: parent.height - 60px - search-bar.height;
                    viewport-y <=> root.browser-y;
                    for item[i] in root.browser-rows: BrowserItem {
                        item: item; text-scale: root.text-scale; selected: root.browser-selected == i;
                        activate => { root.browse-action(false, i, 0); keyboard.focus(); }
                        pointer-activate => { root.browse-action(false, i, 3); keyboard.focus(); }
                        play => { root.browse-action(false, i, 1); }
                        enqueue => { root.browse-action(false, i, 2); }
                        artist(name) => { root.open-artist(name); keyboard.focus(); }
                    }
                }
            }

            if root.wide: FocusScope {
                width: 16px;
                accessible-role: slider;
                accessible-label: "Resize album browser";
                key-pressed(event) => {
                    if (event.text == Key.LeftArrow) { root.library-width = max(220, root.library-width - 20); return accept; }
                    if (event.text == Key.RightArrow) { root.library-width = min(root.viewport-width * 0.45 / (root.text-scale * 1px), root.library-width + 20); return accept; }
                    return reject;
                }
                Rectangle { x: 7px; width: 2px; height: 100%; background: resize.has-hover || resize.pressed ? #7ca7c9 : #394650; }
                resize := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        if (self.pressed) {
                            root.library-width = min(max(220, (root.desktop-library-width + self.mouse-x - self.pressed-x) / (root.text-scale * 1px)), root.viewport-width * 0.45 / (root.text-scale * 1px));
                        }
                    }
                    double-clicked => { root.library-width = 280; }
                }
            }
            if root.wide || !root.show-library: VerticalLayout {
                min-width: 0px; horizontal-stretch: 1;
                spacing: 10px;
                if !root.wide || root.can-back: HorizontalLayout {
                    Button { text: "Back"; max-width: 90px; clicked => { root.back(); keyboard.focus(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    Image { source: root.album-art; width: 64px; height: 64px; image-fit: contain; }
                    Text { text: root.album-title; color: #f0f3f7; font-size: 27px * root.text-scale; font-weight: 600; wrap: word-wrap; }
                }
                if root.artist-view: Text { text: root.album-artist; color: #a9bac9; wrap: word-wrap; }
                if !root.artist-view: artist-link := FocusScope {
                    enabled: root.tracks.length > 0;
                    height: 24px * root.text-scale;
                    accessible-role: button; accessible-label: "Artist: " + root.album-artist;
                    accessible-action-default => { root.open-artist(root.album-artist); }
                    key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.open-artist(root.album-artist); return accept; } return reject; }
                    Text { x: 0px; y: 0px; width: 100%; height: 100%; horizontal-alignment: left; text: root.album-artist; color: #a8c9e2; overflow: elide; font-weight: artist-link.has-focus || artist-click.has-hover ? 600 : 400; }
                    artist-click := TouchArea { clicked => { root.open-artist(root.album-artist); keyboard.focus(); } }
                }
                if root.artist-view: ListView {
                    accessible-label: "Artist releases";
                    min-height: 0px; preferred-height: 0px; vertical-stretch: 1;
                    viewport-y <=> root.detail-y;
                    for item[i] in root.artist-rows: BrowserItem {
                        item: item; text-scale: root.text-scale; show-album: false;
                        activate => { root.browse-action(true, i, 0); keyboard.focus(); }
                        pointer-activate => { root.browse-action(true, i, 3); keyboard.focus(); }
                        play => { root.browse-action(true, i, 1); }
                        enqueue => { root.browse-action(true, i, 2); }
                        artist(name) => { root.open-artist(name); keyboard.focus(); }
                    }
                }
                if !root.artist-view && root.collector-active: ComboBox { model: root.album-sources; current-index <=> root.album-source-index; selected(_) => { root.album-source-selected(self.current-index); } }
                if !root.artist-view: HorizontalLayout {
                    Button { text: "Play album"; enabled: root.tracks.length > 0 && !root.album-ambiguous; clicked => { root.play-track(0); } }
                    if root.collector-active: Button { text: "Download album"; enabled: !root.collector-busy && root.collector-online; clicked => { root.download-action(0); } }
                    if root.collector-active: Button { text: "Download track"; enabled: !root.collector-busy && root.collector-online && root.selected-track >= 0; clicked => { root.download-action(6); } }
                    if root.collector-active: Button { text: "Remove download"; clicked => { root.download-action(1); } }
                }
                if !root.artist-view: HorizontalLayout {
                    spacing: 0px;
                    for label[i] in ["Tracks", "Up next (" + root.queued.length + ")"] : tab := FocusScope {
                        height: 34px;
                        accessible-role: AccessibleRole.tab;
                        accessible-label: label + (root.show-queue == (i == 1) ? ", selected" : "");
                        key-pressed(event) => {
                            if (event.text == " " || event.text == Key.Return) { root.show-queue = i == 1; return accept; }
                            if (event.text == Key.LeftArrow || event.text == Key.RightArrow) { root.show-queue = !root.show-queue; return accept; }
                            return reject;
                        }
                        accessible-action-default => { root.show-queue = i == 1; }
                        Text { text: label; color: root.show-queue == (i == 1) ? #edf3f8 : #93acbf; horizontal-alignment: center; vertical-alignment: center; }
                        Rectangle { y: parent.height - 2px; height: 2px; width: 100%; background: root.show-queue == (i == 1) ? #7ca7c9 : #303c47; }
                        TouchArea { clicked => { root.show-queue = i == 1; tab.focus(); } }
                    }
                }
                if !root.show-queue && !root.artist-view: ListView {
                    accessible-label: "Album tracks";
                    viewport-y <=> root.track-y;
                        min-height: 0px; preferred-height: 0px; vertical-stretch: 1;
                    for track[i] in root.tracks: TrackItem {
                        track: track; text-scale: root.text-scale;
                        selected: i == root.selected-track; current: i == root.active-track;
                        select => { root.selected-track = i; root.album-track-selected(); keyboard.focus(); }
                        play => { root.play-track(i); keyboard.focus(); }
                        enqueue => { root.enqueue(i); }
                    }
                }
                if root.show-queue && !root.artist-view: VerticalLayout {
                    Button { text: "Clear up next"; clicked => { root.clear-queue(); } }
                    ListView {
                        min-height: 0px; preferred-height: 0px; vertical-stretch: 1;
                        for title in root.queued: Text { text: title; color: #dce5ed; height: 34px; overflow: elide; }
                    }
                }
            }
        }
        Rectangle {
            height: 104px * root.text-scale;
            background: #151d24; border-radius: 9px;
            VerticalLayout {
                padding: 8px; spacing: 4px;
                HorizontalLayout {
                    spacing: 10px;
                    Button { icon: @image-url("icons/previous.svg"); accessible-label: "Previous track"; width: 40px; clicked => { root.previous(); } }
                    Rectangle {
                        width: 48px; height: 40px; border-radius: 12px;
                        background: #7ca7c9;
                        opacity: root.playing && !root.reduced-motion ? 0.82 + 0.18 * sin(animation-tick() / 1s * 100deg) : 1;
                        Button { icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg"); accessible-label: root.playing ? "Pause" : "Play"; clicked => { root.toggle-play(); } }
                    }
                    Button { icon: @image-url("icons/next.svg"); accessible-label: "Next track"; width: 40px; clicked => { root.next(); } }
                    VerticalLayout {
                        Text { text: root.now-title; color: #edf3f8; overflow: elide; font-weight: 600; }
                        Text { text: root.now-artist; color: #93acbf; overflow: elide; font-size: 12px * root.text-scale; }
                    }
                    if root.wide: Rectangle {
                        width: 68px; background: #293845;
                        Rectangle { y: parent.height * (1 - root.level); height: parent.height * root.level; width: parent.width; background: #7ca7c9; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.elapsed; color: #97adbe; width: 40px; vertical-alignment: center; }
                    playhead := TransportSeek { position <=> root.progress; seek(v) => { root.seek(v); } }
                    Text { text: root.duration; color: #97adbe; width: 40px; vertical-alignment: center; }
                }
                if root.scanning: Rectangle {
                    height: 3px; background: #303c47;
                    Rectangle { height: 100%; width: parent.width * root.scan-progress; background: #7ca7c9; }
                }
                HorizontalLayout {
                    height: 18px * root.text-scale; spacing: 6px;
                    Text { text: root.status; color: #a7b8c6; overflow: elide; vertical-alignment: center; font-size: 11px * root.text-scale; accessible-label: "Playback status"; horizontal-stretch: 1; }
                    ConnectionIndicator { kind: root.connection-kind; text-scale: root.text-scale; available-width: parent.width; }
                }
            }
        }

    }
    }
}
