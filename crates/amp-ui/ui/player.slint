import { Slider, CheckBox } from "themed-controls.slint";
import { IconButton, ButtonHints } from "icon-button.slint";
export { ButtonHints }
import { TransportButton } from "transport-button.slint";
import { Theme } from "theme.slint";
import { Palette, Button, ScrollView, ListView, AboutSlint, ComboBox, LineEdit, ProgressIndicator } from "std-widgets.slint";
import { BrowserItem, BrowserRow } from "browser-item.slint";
export { BrowserRow }
import { TrackItem, TrackMetrics, TrackRow } from "track-item.slint";
export { TrackRow }
import { TransportSeek } from "transport-seek.slint";
import { FileLoadingStatus } from "file-loading-status.slint";
import { ErrorDialog } from "error-dialog.slint";
import { ConnectionIndicator, ConnectionKind } from "connection-indicator.slint";
export { ConnectionKind }
export struct AlbumMatchRow { artwork: image, title:string, artist:string, detail:string, tracks:string, release:string, applicable:bool }
export struct DownloadRow { id: string, title: string, detail: string, pending: bool, complete: bool }
export enum ListAction { create, rename, delete, append-album, append-track, remove-entry, move-up, move-down, retry, discard, append-disc }
enum HomeAction { browse, open-folder, refresh-folder, refresh-device, refresh-server, add-server }
export component PlayerWindow inherits Window {
    in-out property <string> error-title: "Connection failed";
    in-out property <string> error-message;
    changed error-message => {
        if root.error-message != "" { error-dialog.take-focus(); }
        else { keyboard.focus(); }
    }
    in-out property <bool> loading-files;
    in property <string> loading-message;
    in property <string> loading-path;
    in property <bool> drop-hovered;
    in property <bool> adhoc-queue;
    in property <bool> show-disc-selector;
    callback cancel-file-load();
    in property <ConnectionKind> connection-kind;
    icon: @image-url("../../../assets/macos/trash-amp.png");
    in property <[string]> sources;
    in-out property <int> source-index;
    callback source-changed(int);
    in property <[string]> servers;
    in-out property <int> server-index;
    callback server-changed(int);
    callback open-device-library();
    in-out property <bool> lists-open;
    in-out property <int> settings-tab;
    in-out property <string> server-url;
    in-out property <string> certificate-path;
    in-out property <int> collector-playback-format;
    in-out property <string> collector-opus-bitrate: "128";
    in-out property <string> collector-playback-status;
    callback save-collector-playback();
    in property <string> connection-status;
    in property <bool> collector-active;
    in property <bool> device-library-active;
    in property <bool> device-library-available;
    in property <string> source-status;
    in property <bool> source-loading;
    in property <float> source-progress;
    in property <bool> source-progress-indeterminate;
    in property <string> source-progress-message;
    callback music-access-settings();
    in property <bool> collector-online;
    in property <bool> collector-busy;
    in property <bool> removing-connection;
    in property <[string]> collections;
    in-out property <int> collection-index;
    callback collection-changed(int);
    in property <[string]> saved-lists;
    in-out property <int> list-index: -1;
    callback list-selected(int);
    in property <[BrowserRow]> list-rows;
    in-out property <int> list-entry: -1;
    in property <bool> list-editable;
    in-out property <string> list-name;
    in-out property <string> download-budget: "10";
    in property <[DownloadRow]> download-rows;
    in property <string> download-status;
    callback remove-download-record(string);
    in property <image> album-art;
    in property <[string]> album-sources;
    in-out property <int> album-source-index;
    in property <bool> album-ambiguous;
    callback album-source-selected(int);
    callback connect-server(); callback cancel-connect(); callback refresh-server(); callback remove-server();
    callback list-command(ListAction); callback play-list(bool); callback play-list-from(int); callback download-action(int); callback save-budget();
    title: "Trash Amp";
    in property <string> application-version;
    preferred-width: 980px; preferred-height: 680px; min-width: 330px; min-height: 230px; max-width: 10000px; max-height: 10000px;
    background: Theme.canvas;
    default-font-family: "Helvetica Neue";
    default-font-size: 14px * root.text-scale;
    in-out property <float> text-scale: 1;
    in-out property <int> audio-buffer-seconds: 15;
    in-out property <bool> crossfeed-enabled;
    in-out property <int> crossfeed-cutoff: 700;
    // Store tenths of a dB so preset matching and persistence stay exact.
    in-out property <int> crossfeed-feed: 45;
    out property <int> crossfeed-preset: root.crossfeed-cutoff == 700 && root.crossfeed-feed == 45 ? 0
        : root.crossfeed-cutoff == 700 && root.crossfeed-feed == 60 ? 1
        : root.crossfeed-cutoff == 650 && root.crossfeed-feed == 95 ? 2 : 3;
    public function select-crossfeed-preset(index: int) {
        if index >= 0 && index < 3 {
            root.crossfeed-cutoff = index == 2 ? 650 : 700;
            root.crossfeed-feed = index == 0 ? 45 : index == 1 ? 60 : 95;
            root.preferences-changed();
        }
    }
    in property <[TrackRow]> tracks;
    in property <[string]> queued;
    in property <string> album-title: "Your albums, close at hand.";
    in property <string> album-artist: "Open a music folder to begin.";
    in property <string> now-title: "Nothing playing";
    in property <string> now-artist;
    in property <string> status: "Choose a folder, including a mounted network drive.";
    in property <string> elapsed: "0:00";
    in property <string> duration: "0:00";
    in property <bool> playing;
    in property <bool> has-current-track;
    in-out property <float> progress;
    out property <bool> scrubbing: playhead.scrubbing;
    in property <float> level;
    in property <bool> scanning;
    in property <float> scan-progress;
    in property <string> scan-summary;
    in property <string> scan-details;
    in-out property <bool> scan-details-open;
    in property <[BrowserRow]> browser-rows;
    in property <[BrowserRow]> artist-rows;
    in property <bool> artist-view;
    in property <bool> can-back;
    in property <bool> section-open;
    in property <int> browser-selected: -1;
    in-out property <length> browser-y;
    in-out property <length> detail-y;
    in-out property <length> track-y;
    in-out property <string> search-text;
    in-out property <bool> search-editing;
    private property <bool> form-editing;
    in-out property <bool> focus-search;
    callback search-changed();
    callback focus-search-requested();
    callback browse-action(bool, int, int);
    callback open-artist(string);
    callback back();
    callback activate-selection();
    in-out property <bool> collector-album-loading: false;
    in-out property <bool> collector-list-loading: false;
    callback album-track-selected();
    callback move-album-track-selection(int, length);
    public pure function album-track-height(track: TrackRow) -> length {
        return TrackMetrics.height(track, root.text-scale);
    }
    in-out property <int> sort-order;
    callback sort-changed();
    in-out property <int> selected-track: -1;
    in property <int> selected-album: -1;
    in property <int> active-track: -1;
    in-out property <bool> dark-mode <=> Theme.dark;
    in-out property <bool> oled-mode <=> Theme.oled;
    init => { Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light; }
    changed dark-mode => { Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light; }
    in-out property <bool> reduced-motion;
    in-out property <bool> prefer-raw: true;
    in-out property <bool> automatic-metadata: true;
    in-out property <string> acoustid-api-key;
    in property <bool> album-matching-busy;
    in property <bool> album-matching-available;
    in-out property <bool> album-matching-open;
    in-out property <int> album-matching-version: -1;
    in property <string> album-matching-status;
    in property <[AlbumMatchRow]> album-matching-rows;
    callback find-album-matches();
    callback cancel-album-matching();
    callback apply-album-match(string);
    in-out property <bool> settings;
    // Launch routing is supplied by the host; returning Home preserves browse state.
    in-out property <bool> home;
    in property <bool> library-browsable;
    private property <HomeAction> home-action: root.library-browsable ? HomeAction.browse
        : root.collector-active ? HomeAction.refresh-server
        : root.device-library-active ? HomeAction.refresh-device
        : root.can-open-folder ? (root.folder-index >= 0 ? HomeAction.refresh-folder : HomeAction.open-folder)
        : HomeAction.add-server;
    changed home => {
        if root.home { root.settings = false; root.lists-open = false; root.search-editing = false; }
    }
    in-out property <bool> show-library: true;
    in-out property <bool> show-queue;
    // Store the desktop choice independently of the temporary phone layout.
    in-out property <float> library-width: 280;
    // Snapshot the viewport to keep layout constraints independent of Window's layout hints.
    private property <length> content-width: 980px;
    changed width => { root.content-width = self.width; }
    private property <length> desktop-library-width: min(max(220px * root.text-scale, root.library-width * root.text-scale * 1px), root.content-width * 0.45);
    in property <bool> wide: true;
    in property <bool> touch-input;
    private property <bool> edge-to-edge: root.touch-input || !root.wide;
    private property <length> dock-bottom-inset: root.edge-to-edge && root.virtual-keyboard-size.height == 0px ? root.safe-area-insets.bottom : 0px;
    out property <bool> tap-to-play: root.touch-input;
    in property <bool> short: false;
    changed settings => {
        if root.settings { root.search-editing = false; root.lists-open = false; root.home = false; }
        else { root.form-editing = false; }
    }
    changed lists-open => {
        if root.lists-open { root.search-editing = false; root.settings = false; root.home = false; }
        else { root.form-editing = false; }
    }
    changed settings-tab => { root.form-editing = false; }
    changed collector-playback-format => { root.form-editing = false; }
    changed show-library => { if !root.show-library && !root.wide { root.search-editing = false; } }
    changed wide => { if !root.wide && !root.show-library { root.search-editing = false; } }
    in property <bool> can-open-folder: true;
    callback open-folder(); callback demo();
    in property <[string]> folder-libraries;
    in-out property <int> folder-index: -1;
    callback folder-selected(int);
    callback refresh-folder();
    callback play-album();
    callback play-track(int); callback enqueue(int); callback toggle-play();
    callback previous(); callback next(); callback seek(float);
    callback preferences-changed(); callback clear-queue();
    forward-focus: keyboard;
    // Continue the dock surface through landscape cutout/gesture side insets.
    // Foreground controls still live inside the safe-area content below.
    if root.edge-to-edge: Rectangle {
        y: keyboard.y + keyboard.height - playback-dock.height;
        width: root.width; height: playback-dock.height;
        background: Theme.transport;
    }
    keyboard := FocusScope {
      enabled: root.error-message == "";
      x: root.safe-area-insets.left;
      y: root.safe-area-insets.top;
      width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
      height: max(0px, min(root.height - (root.edge-to-edge ? 0px : root.safe-area-insets.bottom),
          root.virtual-keyboard-size.height > 0px ? root.virtual-keyboard-position.y : root.height)
          - root.safe-area-insets.top);
      capture-key-pressed(event) => {
        // An active transport owns Space before the focused button sees it.
        if ((root.playing || root.has-current-track) && !root.search-editing && !root.form-editing
            && root.error-message == "" && event.text == " " && !event.modifiers.alt
            && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.shift) {
            if !event.repeat { root.toggle-play(); }
            return accept;
        }
        return reject;
      }
      key-pressed(event) => {
        if ((event.modifiers.control || event.modifiers.meta) && (event.text == "f" || event.text == "F")) {
            root.focus-search-requested(); return accept;
        }
        if (root.search-editing) { return reject; }
        if (!root.settings && !root.lists-open && !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta) {
            if (event.text == " " && !event.modifiers.shift) {
                if !event.repeat { root.toggle-play(); }
                return accept;
            }
            if (event.text == Key.LeftArrow) { root.previous(); return accept; }
            if (event.text == Key.RightArrow) { root.next(); return accept; }
        }
        if (event.text == Key.Escape && (root.settings || root.lists-open)) { root.home = true; keyboard.focus(); return accept; }
        if (event.text == Key.Escape && root.home) { root.home = false; keyboard.focus(); return accept; }
        if (event.text == Key.Return && !root.home && !root.settings && !root.lists-open) { root.activate-selection(); return accept; }
        return reject;
      }
      VerticalLayout {
        // Phone surfaces meet the display edges; spacing belongs to their content.
        // Keep a modest frame and separated panels in a desktop window.
        padding: root.edge-to-edge ? 0px : 12px;
        padding-top: root.edge-to-edge ? 4px : 12px;
        spacing: root.edge-to-edge ? 0px : 8px;
        // Source and library selection live on Home, never above the track list.
        if root.settings || root.lists-open: HorizontalLayout {
            height: 52px; spacing: 8px;
            padding-left: root.wide ? 0px : 16px; padding-right: root.wide ? 0px : 16px;
            IconButton { label: "Home"; icon: @image-url("icons/home.svg"); clicked => { root.home = true; keyboard.focus(); } }
            Text { text: root.settings ? "Settings" : "Lists"; color: Theme.text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        }
        if root.home: Rectangle {
            accessible-role: groupbox; accessible-label: "Home page";
            background: Theme.raised; border-radius: root.edge-to-edge ? 0px : 6px;
            home-scroll := ScrollView {
                mouse-drag-pan-enabled: true;
                width: 100%; height: 100%;
                content-width: self.visible-width;
                content-height: max(self.visible-height, home-content.min-height);
                home-content := VerticalLayout {
                    x: max(0px, (home-scroll.visible-width - self.width) / 2);
                    width: min(home-scroll.visible-width, 560px);
                    height: home-scroll.content-height;
                    padding: root.wide ? 24px : 16px; spacing: 16px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Home"; color: Theme.text; font-size: 27px * root.text-scale; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton { label: "Settings"; icon: @image-url("icons/settings.svg"); clicked => { root.settings = true; keyboard.focus(); } }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Source"; color: Theme.text; font-weight: 600; }
                        ComboBox { model: root.sources; current-index <=> root.source-index; accessible-label: "Music source"; min-height: 44px;
                            selected(i) => { root.source-changed(self.current-index); } }
                    }
                    if root.source-status != "": Text { text: root.source-status; color: Theme.muted; wrap: word-wrap; accessible-label: "Music source status"; }
                    if root.device-library-active: VerticalLayout {
                        spacing: 8px;
                        Text { text: "Music stored on this device"; color: Theme.text; font-weight: 600; }
                        Text { text: "Cloud-only and protected songs are shown but cannot play. Sync or download unprotected music in Music, then refresh."; color: Theme.muted; wrap: word-wrap; }
                        if root.library-browsable: Button { text: root.scanning ? "Refreshing…" : "Refresh music library"; min-height: 44px; enabled: !root.scanning; clicked => { root.refresh-folder(); } }
                        Button { text: "Music access settings"; min-height: 44px; clicked => { root.music-access-settings(); } }
                    }
                    if root.collector-active: VerticalLayout {
                        spacing: 6px;
                        Text { text: "Library"; color: Theme.text; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 6px;
                            ComboBox { model: root.collections; current-index <=> root.collection-index; accessible-label: "Music collection"; horizontal-stretch: 1;
                                selected(i) => { root.collection-changed(self.current-index); } }
                            if root.library-browsable: IconButton { label: "Refresh"; icon: @image-url("icons/refresh.svg"); enabled: !root.collector-busy; clicked => { root.refresh-server(); } }
                        }
                        Text { text: root.connection-status; color: Theme.muted; wrap: word-wrap; }
                    }
                    if !root.collector-active && !root.device-library-active && root.folder-libraries.length > 0: VerticalLayout {
                        spacing: 6px;
                        Text { text: "Folder library"; color: Theme.text; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 6px;
                            ComboBox { model: root.folder-libraries; current-index <=> root.folder-index; accessible-label: "Saved folder library"; horizontal-stretch: 1;
                                selected(i) => { root.folder-selected(self.current-index); } }
                            if root.library-browsable: IconButton { label: "Refresh folder"; icon: @image-url("icons/refresh.svg"); enabled: root.folder-index >= 0 && !root.scanning; clicked => { root.refresh-folder(); } }
                        }
                    }
                    if !root.library-browsable && !root.collector-active && !root.device-library-active && root.folder-libraries.length == 0: Text {
                        text: root.can-open-folder ? "Open a music folder to start a local library." : "Add a server to start listening.";
                        color: Theme.muted; wrap: word-wrap;
                    }
                    Rectangle {
                        height: max(44px, 34px * root.text-scale);
                        IconButton {
                            width: 100%; height: 100%; primary: true;
                            text: root.home-action == HomeAction.browse ? "Browse library"
                                : root.home-action == HomeAction.open-folder ? "Open folder"
                                : root.home-action == HomeAction.refresh-server ? "Refresh library"
                                : root.home-action == HomeAction.refresh-device ? "Refresh music library"
                                : root.home-action == HomeAction.refresh-folder ? "Refresh folder"
                                : "Add a server";
                            label: self.text;
                            enabled: root.home-action == HomeAction.refresh-server ? !root.collector-busy
                                : (root.home-action == HomeAction.refresh-folder || root.home-action == HomeAction.refresh-device) ? !root.scanning
                                : true;
                            clicked => {
                                if root.home-action == HomeAction.browse { root.home = false; keyboard.focus(); }
                                else if root.home-action == HomeAction.open-folder { root.open-folder(); }
                                else if root.home-action == HomeAction.refresh-server { root.refresh-server(); }
                                else if root.home-action == HomeAction.add-server { root.settings-tab = 1; root.settings = true; keyboard.focus(); }
                                else { root.refresh-folder(); }
                            }
                        }
                    }
                    if root.collector-active: Button { text: "Lists"; accessible-label: "Lists"; min-height: 44px;
                        clicked => { root.lists-open = true; keyboard.focus(); } }
                    if root.home-action != HomeAction.add-server: Rectangle { height: 1px; background: Theme.divider; }
                    if root.can-open-folder && root.home-action != HomeAction.open-folder: Button { text: "Open folder"; accessible-label: "Open folder"; min-height: 44px;
                        clicked => { root.open-folder(); } }
                    if root.home-action != HomeAction.add-server: Button { text: "Manage servers"; accessible-label: "Manage servers"; min-height: 44px;
                        clicked => { root.settings-tab = 1; root.settings = true; keyboard.focus(); } }
                    Rectangle { min-height: 0px; vertical-stretch: 1; }
                }
            }
        }
        if root.lists-open: Rectangle {
            background: Theme.raised; border-radius: root.edge-to-edge ? 0px : 6px;
            collector-scroll := ScrollView {
                mouse-drag-pan-enabled: true;
                width: 100%; height: 100%;
                content-width: max(self.visible-width, collector-content.min-width);
                content-height: max(self.visible-height, collector-content.min-height);
                collector-content := VerticalLayout {
                width: collector-scroll.content-width; height: collector-scroll.content-height;
                padding: root.wide ? 12px : 16px; spacing: 8px;
                Text { text: root.connection-status; color: Theme.muted; wrap: word-wrap; }
                HorizontalLayout {
                    ComboBox { model: root.saved-lists; current-index <=> root.list-index; selected(i) => { root.list-selected(self.current-index); } }
                    IconButton { label: "Play"; icon: @image-url("icons/play.svg"); enabled: !root.collector-list-loading && root.list-rows.length > 0 && root.list-index > 0; clicked => { root.play-list(false); } }
                    IconButton { label: "Shuffle"; icon: @image-url("icons/shuffle.svg"); enabled: !root.collector-list-loading && root.list-rows.length > 0 && root.list-index > 0; clicked => { root.play-list(true); } }
                    IconButton { label: "Download list"; icon: @image-url("icons/download.svg"); enabled: !root.collector-list-loading && root.list-rows.length > 0 && !root.collector-busy && root.collector-online && root.list-index > 0; clicked => { root.download-action(2); } }
                    IconButton { label: "Remove list downloads"; icon: @image-url("icons/remove-download.svg"); enabled: root.list-index > 0; clicked => { root.download-action(3); } }
                }
                HorizontalLayout {
                    LineEdit { text <=> root.list-name; placeholder-text: "List name"; accessible-label: "List name";
                        changed has-focus => { root.form-editing = self.has-focus; } }
                    IconButton { label: "Create"; icon: @image-url("icons/plus.svg"); enabled: !root.collector-busy && root.collector-online && root.list-editable; clicked => { root.list-command(ListAction.create); } }
                    IconButton { label: "Rename"; icon: @image-url("icons/edit.svg"); enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-index > 0; clicked => { root.list-command(ListAction.rename); } }
                    IconButton { label: "Delete"; icon: @image-url("icons/trash.svg"); enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-index > 0; clicked => { root.list-command(ListAction.delete); } }
                }
                HorizontalLayout {
                    Button { text: "Append album"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.selected-album >= 0; clicked => { root.list-command(ListAction.append-album); } }
                    Button { text: "Append disc"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.selected-album >= 0; clicked => { root.list-command(ListAction.append-disc); } }
                    Button { text: "Append track"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.selected-track >= 0; clicked => { root.list-command(ListAction.append-track); } }
                    Button { text: "Remove entry"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-entry >= 0; clicked => { root.list-command(ListAction.remove-entry); } }
                    IconButton { label: "Move up"; icon: @image-url("icons/up.svg"); enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-entry > 0; clicked => { root.list-command(ListAction.move-up); } }
                    IconButton { label: "Move down"; icon: @image-url("icons/down.svg"); enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-entry >= 0; clicked => { root.list-command(ListAction.move-down); } }
                }
                HorizontalLayout {
                    Button { text: "Retry original changes"; enabled: !root.collector-album-loading && !root.collector-busy && root.collector-online; clicked => { root.list-command(ListAction.retry); } }
                    Button { text: "Discard unresolved changes"; enabled: !root.collector-busy; clicked => { root.list-command(ListAction.discard); } }
                }
                if root.collector-list-loading: Text { text: "Loading playlist entries…"; color: Theme.muted; wrap: word-wrap; }
                ListView {
                    min-height: 180px; vertical-stretch: 1;
                    for item[i] in root.list-rows: BrowserItem { item: item; selected: i == root.list-entry; tap-to-play: root.tap-to-play;
                        activate => { root.list-entry = i; if root.tap-to-play { root.play-list-from(i); } }
                        pointer-activate => { root.list-entry = i; if root.tap-to-play { root.play-list-from(i); } }
                    }
                }
            }
            }
        }
        if root.settings: Rectangle {
            background: Theme.raised; border-radius: root.edge-to-edge ? 0px : 8px;
            settings-scroll := ScrollView {
                mouse-drag-pan-enabled: true;
                width: 100%; height: 100%;
                content-width: self.visible-width;
                content-height: max(self.visible-height, settings-content.min-height);
                settings-content := VerticalLayout {
                    width: settings-scroll.visible-width;
                    height: settings-scroll.content-height;
                    padding: root.wide ? 12px : 16px; spacing: 12px;
                    private property <bool> tabs-fit: self.width >= 32px + 218px * root.text-scale;
                    if settings-content.tabs-fit: HorizontalLayout {
                        spacing: 6px;
                        Button { text: "General"; enabled: root.settings-tab != 0; clicked => { root.settings-tab = 0; } }
                        Button { text: "Servers"; enabled: root.settings-tab != 1; clicked => { root.settings-tab = 1; } }
                        Button { text: "Downloads"; enabled: root.settings-tab != 2; clicked => { root.settings-tab = 2; } }
                    }
                    if !settings-content.tabs-fit: ComboBox {
                        model: ["General", "Servers", "Downloads"];
                        current-index <=> root.settings-tab;
                        accessible-label: "Settings section";
                        min-height: 44px;
                    }
                    if root.settings-tab == 0: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Appearance"; color: Theme.text; vertical-alignment: center; }
                            ComboBox { model: ["Light", "Dark"]; current-index: root.dark-mode ? 1 : 0;
                                accessible-label: "Color mode";
                                selected(_) => { root.dark-mode = self.current-index == 1; root.preferences-changed(); } }
                        }
                        CheckBox { touch-input: root.touch-input; text: "OLED black backgrounds"; checked <=> root.oled-mode;
                            toggled => { root.preferences-changed(); } }
                        Text { text: "Use pure black backgrounds in dark mode."; color: Theme.muted; wrap: word-wrap; }
                        CheckBox { touch-input: root.touch-input; text: "Prefer redumper raw dumps"; checked <=> root.prefer-raw;
                            toggled => { root.preferences-changed(); } }
                        CheckBox { touch-input: root.touch-input; text: "Automatic metadata from MusicBrainz"; checked <=> root.automatic-metadata;
                            toggled => { root.preferences-changed(); } }
                        Text { text: "AcoustID application key for local album matching"; color: Theme.text; wrap: word-wrap; }
                        LineEdit { text <=> root.acoustid-api-key; accessible-label: "AcoustID application key";
                            changed has-focus => { root.form-editing = self.has-focus; }
                            edited => { root.preferences-changed(); } }
                        Text { text: "Matching is explicit: it sends audio fingerprints and durations, never audio files. Register an application key at acoustid.org."; color: Theme.muted; wrap: word-wrap; }
                        HorizontalLayout {
                            Text { text: "Audio buffer: " + root.audio-buffer-seconds + " s"; color: Theme.text; }
                            Slider { minimum: 3; maximum: 60; step: 1; value: root.audio-buffer-seconds;
                                changed(v) => { root.audio-buffer-seconds = round(v); root.preferences-changed(); } }
                        }
                        Text { text: "More buffer helps with network dropouts and uses more memory. Restart the app to apply changes."; color: Theme.muted; wrap: word-wrap; }
                        CheckBox { touch-input: root.touch-input; text: "Binaural crossfeed"; checked <=> root.crossfeed-enabled;
                            toggled => { root.preferences-changed(); } }
                        Text { text: "Blend stereo channels for headphone listening. Changes apply during playback. Requires stereo output at 2–384 kHz.";
                            color: Theme.muted; wrap: word-wrap; }
                        ComboBox { model: ["Default", "Chu Moy", "Jan Meier", "Custom"];
                            accessible-label: "Crossfeed preset"; enabled: root.crossfeed-enabled;
                            // User selection replaces current-index's initial binding.
                            // Keep a separate binding to resync it after tuning changes.
                            private property <int> derived-preset: root.crossfeed-preset;
                            changed derived-preset => { self.current-index = self.derived-preset; }
                            current-index: self.derived-preset;
                            selected(_) => {
                                root.select-crossfeed-preset(self.current-index);
                                self.current-index = root.crossfeed-preset;
                            } }
                        Text { text: "Crossfeed cutoff: " + root.crossfeed-cutoff + " Hz"; color: Theme.text; wrap: word-wrap; }
                        Slider { minimum: 300; maximum: 2000; step: 1;
                            private property <float> configured-value: root.crossfeed-cutoff;
                            changed configured-value => { self.value = self.configured-value; }
                            value: self.configured-value;
                            label: "Crossfeed cutoff in Hz"; enabled: root.crossfeed-enabled;
                            changed(v) => { root.crossfeed-cutoff = round(v); root.preferences-changed(); } }
                        Text { text: "Crossfeed attenuation: " + floor(root.crossfeed-feed / 10) + "." + mod(root.crossfeed-feed, 10) + " dB";
                            color: Theme.text; wrap: word-wrap; }
                        Slider { minimum: 10; maximum: 150; step: 1;
                            private property <float> configured-value: root.crossfeed-feed;
                            changed configured-value => { self.value = self.configured-value; }
                            value: self.configured-value;
                            label: "Crossfeed attenuation in tenths of a dB"; enabled: root.crossfeed-enabled;
                            changed(v) => { root.crossfeed-feed = round(v); root.preferences-changed(); } }
                        Text { text: "Higher attenuation gives subtler crossfeed."; color: Theme.muted; wrap: word-wrap; }
                        CheckBox { touch-input: root.touch-input; text: "Reduce motion"; checked <=> root.reduced-motion;
                            toggled => { root.preferences-changed(); } }
                        Button { text: "Load 2,000-album layout demo"; clicked => { root.demo(); root.settings = false; } }
                        HorizontalLayout {
                            Text { text: "Text size"; color: Theme.text; }
                            Slider { minimum: 1; maximum: 1.6; value: root.text-scale;
                                changed(v) => { root.text-scale = v; root.preferences-changed(); } }
                        }
                    }
                    if root.settings-tab == 1: VerticalLayout {
                        spacing: 10px;
                        Text { text: "Servers"; color: Theme.text; font-weight: 600; }
                        ComboBox { model: root.servers; current-index <=> root.server-index; accessible-label: "Server to manage"; enabled: root.servers.length > 0; selected(_) => { root.server-changed(self.current-index); } }
                        if root.device-library-available: Button { text: "Open Device Music Library"; clicked => { root.open-device-library(); } }
                        LineEdit { text <=> root.server-url; placeholder-text: "https://collector.example:8443"; accessible-label: "Collector server URL";
                            changed has-focus => { root.form-editing = self.has-focus; } }
                        HorizontalLayout {
                            Button { text: settings-content.tabs-fit ? "Connect / Reconnect" : "Connect"; enabled: !root.collector-busy; clicked => { root.connect-server(); } }
                            Button { text: "Cancel"; enabled: root.collector-busy; clicked => { root.cancel-connect(); } }
                        }
                        LineEdit { text <=> root.certificate-path; placeholder-text: "Optional owner-provided PEM or pairing JSON path"; accessible-label: "Owner-provided trust file";
                            changed has-focus => { root.form-editing = self.has-focus; } }
                        Text { text: root.connection-status; color: Theme.text; wrap: word-wrap; }
                        Button { text: root.removing-connection ? "Removing connection…" : "Remove connection"; enabled: root.collector-active && !root.collector-busy && !root.removing-connection; clicked => { root.remove-server(); } }
                        Text { text: "Collector playback format"; color: Theme.text; font-weight: 600; }
                        ComboBox {
                            model: ["Original", "High Bandwidth", "Low Bandwidth"];
                            current-index <=> root.collector-playback-format;
                            accessible-label: "Collector playback format";
                            selected(_) => { root.collector-playback-status = ""; }
                        }
                        if root.collector-playback-format == 2: LineEdit {
                            text <=> root.collector-opus-bitrate;
                            placeholder-text: "6–256 kbps";
                            accessible-label: "Opus bitrate in kbps";
                            changed has-focus => { root.form-editing = self.has-focus; }
                            edited(_) => { root.collector-playback-status = ""; }
                            accepted => { root.save-collector-playback(); }
                        }
                        Text { text: "High Bandwidth uses existing FLAC or MP3, or live FLAC. Low Bandwidth uses Opus at the selected bitrate. This setting applies to all Collector servers on this device. Offline downloads and separate media connections play saved audio."; color: Theme.muted; wrap: word-wrap; }
                        Button { text: "Save playback format"; clicked => { root.save-collector-playback(); } }
                        if root.collector-playback-status != "": Text {
                            text: root.collector-playback-status; color: Theme.text; wrap: word-wrap;
                        }
                    }
                    if root.settings-tab == 2: VerticalLayout {
                        spacing: 10px;
                        Text { text: "Downloads"; color: Theme.text; font-weight: 600; }
                        Text { text: "Audio storage limit (GiB)"; color: Theme.muted; }
                        HorizontalLayout {
                            LineEdit { text <=> root.download-budget; placeholder-text: "Audio budget (GiB)"; accessible-label: "Download budget in GiB";
                                changed has-focus => { root.form-editing = self.has-focus; } }
                            Button { text: "Set GiB limit"; clicked => { root.save-budget(); } }
                        }
                        HorizontalLayout {
                            Button { text: settings-content.tabs-fit ? "Retry downloads" : "Retry"; accessible-label: "Retry downloads"; clicked => { root.download-action(4); } }
                            Button { text: settings-content.tabs-fit ? "Cancel downloads" : "Cancel"; accessible-label: "Cancel downloads"; clicked => { root.download-action(5); } }
                        }
                        if root.download-status != "": Text {
                            text: root.download-status; color: Theme.muted; wrap: word-wrap;
                            accessible-live-region: polite;
                        }
                        if root.download-rows.length == 0: Text {
                            text: "No downloads on this device."; color: Theme.muted; wrap: word-wrap;
                        }
                        if root.download-rows.length > 0: ListView {
                            accessible-label: "Downloads on this device";
                            height: clamp(root.height / 3, 144px, 260px);
                            for entry in root.download-rows: HorizontalLayout {
                                height: 54px * root.text-scale; spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1; alignment: center;
                                    Text { text: entry.title; color: Theme.text; overflow: elide; }
                                    Text { text: entry.detail; color: Theme.muted; overflow: elide; font-size: 12px * root.text-scale; }
                                }
                                if !entry.pending: Button {
                                    min-height: 44px; text: entry.complete ? "Remove" : "Clear";
                                    accessible-label: (entry.complete ? "Remove download for " : "Clear download record for ") + entry.title;
                                    clicked => { root.remove-download-record(entry.id); }
                                }
                            }
                        }
                    }
                    Rectangle { min-height: 12px; vertical-stretch: 1; }
                    if root.settings-tab == 0: HorizontalLayout {
                        alignment: center;
                        AboutSlint { width: 240px; height: 112px; }
                    }
                    if root.settings-tab == 0: Text { text: "Trash Amp " + root.application-version; color: Theme.muted; horizontal-alignment: center; }
                }
            }
        }
        if !root.home && !root.settings && !root.lists-open: HorizontalLayout {
            min-height: 0px; vertical-stretch: 1;
            spacing: 0px;
            if root.wide || root.show-library: Rectangle {
                accessible-role: groupbox;
                accessible-label: "Album browser";
                preferred-width: root.wide ? root.desktop-library-width : 280px;
                max-width: root.wide ? root.desktop-library-width : 10000px;
                min-width: root.wide ? root.desktop-library-width : 0px;
                horizontal-stretch: root.wide ? 0 : 1;
                background: Theme.raised; border-radius: root.edge-to-edge ? 0px : 6px;
                browser-scroll := ScrollView {
                    width: 100%; height: 100%;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, root.short ? 104px + 36px * root.text-scale : 0px);
                    mouse-drag-pan-enabled: root.short && root.touch-input;
                    Rectangle {
                        width: browser-scroll.visible-width; height: browser-scroll.content-height;
                        HorizontalLayout {
                            x: 8px; y: 8px; width: parent.width - 16px; height: 44px; spacing: 6px;
                            IconButton { label: "Home"; icon: @image-url("icons/home.svg"); clicked => { root.home = true; keyboard.focus(); } }
                            ComboBox { model: ["Albums", "Artists"]; current-index <=> root.sort-order; selected(_) => { root.sort-changed(); } }
                            if root.section-open: IconButton { label: "Back"; icon: @image-url("icons/back.svg"); button-size: 32px; clicked => { root.back(); keyboard.focus(); } }
                        }
                        search-bar := HorizontalLayout {
                            x: 8px; y: root.wide ? 58px : parent.height - self.height - 8px;
                            width: parent.width - 16px; height: 36px * root.text-scale; spacing: 4px;
                            search := LineEdit {
                                in-out property <bool> request-focus <=> root.focus-search;
                                changed request-focus => { if self.request-focus { self.focus(); self.request-focus = false; } }
                                init => { if self.request-focus { self.focus(); self.request-focus = false; } }
                                changed has-focus => {
                                    root.search-editing = self.has-focus;
                                    if self.has-focus && root.short {
                                        browser-scroll.content-y = max(-search-bar.y, min(browser-scroll.content-y,
                                            browser-scroll.visible-height - search-bar.y - search-bar.height));
                                    }
                                }
                                placeholder-text: "Search library"; accessible-label: "Search library";
                                text <=> root.search-text;
                                edited(_) => { root.search-changed(); }
                                key-pressed(event) => {
                                    if event.text == Key.Escape { keyboard.focus(); return accept; }
                                    return reject;
                                }
                            }
                            if root.search-text != "": IconButton { label: "Clear search"; icon: @image-url("icons/close.svg"); button-size: 36px;
                                clicked => { root.search-text = ""; root.search-changed(); search.focus(); } }
                        }
                        list := ListView {
                            x: 8px; y: root.wide ? 64px + search-bar.height : 58px;
                            width: parent.width - 16px;
                            height: max(0px, parent.height - 72px - search-bar.height);
                            content-y <=> root.browser-y;
                            for item[i] in root.browser-rows: BrowserItem {
                                item: item; text-scale: root.text-scale; selected: root.browser-selected == i; tap-to-play: root.tap-to-play;
                                activate => { root.browse-action(false, i, 0); keyboard.focus(); }
                                pointer-activate => { root.browse-action(false, i, 3); keyboard.focus(); }
                                play => { root.browse-action(false, i, 1); }
                                enqueue => { root.browse-action(false, i, 2); }
                                artist(name) => { root.open-artist(name); keyboard.focus(); }
                            }
                        }
                    }
                }
            }

            if root.wide: FocusScope {
                width: 16px;
                accessible-role: slider;
                accessible-label: "Resize album browser";
                key-pressed(event) => {
                    if (event.text == Key.LeftArrow) { root.library-width = max(220, root.library-width - 20); return accept; }
                    if (event.text == Key.RightArrow) { root.library-width = min(root.content-width * 0.45 / (root.text-scale * 1px), root.library-width + 20); return accept; }
                    return reject;
                }
                Rectangle { x: 7px; width: 2px; height: 100%; background: resize.has-hover || resize.pressed ? Theme.accent : Theme.divider; }
                resize := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        if (self.pressed) {
                            root.library-width = min(max(220, (root.desktop-library-width + self.mouse-x - self.pressed-x) / (root.text-scale * 1px)), root.content-width * 0.45 / (root.text-scale * 1px));
                        }
                    }
                    double-clicked => { root.library-width = 280; }
                }
            }
            if root.wide || !root.show-library: details := ScrollView {
                min-width: 0px; min-height: 0px; horizontal-stretch: 1;
                content-width: self.visible-width;
                content-height: max(self.visible-height, detail-content.min-height);
                mouse-drag-pan-enabled: root.short && root.touch-input;
                detail-content := VerticalLayout {
                    width: details.visible-width; height: details.content-height;
                    padding: root.wide ? 0px : (root.short ? 8px : 16px);
                    spacing: root.short ? 4px : 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        if !root.wide || root.can-back: IconButton { label: "Back"; icon: @image-url("icons/back.svg"); clicked => { root.back(); keyboard.focus(); } }
                        if root.album-art.width > 0 && !root.artist-view && !(root.show-queue && root.adhoc-queue): Image {
                            source: root.album-art; width: root.short ? 36px : (root.wide ? 64px : 48px); height: self.width; image-fit: contain;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center; spacing: 2px;
                            Text {
                                text: root.show-queue && root.adhoc-queue && !root.artist-view ? "Ad hoc playlist" : root.album-title;
                                color: Theme.text; font-size: (root.short ? 20px : (root.wide ? 27px : 22px)) * root.text-scale;
                                font-weight: 600; wrap: word-wrap;
                            }
                            if root.artist-view: Text { text: root.album-artist; color: Theme.muted; wrap: word-wrap; }
                            if !root.artist-view && !(root.show-queue && root.adhoc-queue) && root.album-artist != "": artist-link := FocusScope {
                                enabled: !root.collector-album-loading && root.tracks.length > 0;
                                height: 24px * root.text-scale;
                                accessible-role: button; accessible-label: "Artist: " + root.album-artist;
                                accessible-enabled: self.enabled;
                                accessible-action-default => { if self.enabled { root.open-artist(root.album-artist); } }
                                key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.open-artist(root.album-artist); return accept; } return reject; }
                                Text { width: 100%; height: 100%; text: root.album-artist; color: artist-link.enabled ? Theme.link : Theme.muted; overflow: elide; font-weight: artist-link.has-focus || artist-click.has-hover ? 600 : 400; }
                                artist-click := TouchArea { enabled: artist-link.enabled; clicked => { root.open-artist(root.album-artist); keyboard.focus(); } }
                            }
                        }
                        if root.artist-view && !root.wide: IconButton { label: "Home"; icon: @image-url("icons/home.svg"); clicked => { root.home = true; keyboard.focus(); } }
                    }
                    if root.artist-view: ListView {
                        accessible-label: "Artist releases";
                        min-height: root.short ? 48px * root.text-scale : 0px; preferred-height: 0px; vertical-stretch: 1;
                        content-y <=> root.detail-y;
                        for item[i] in root.artist-rows: BrowserItem {
                            item: item; text-scale: root.text-scale; show-album: false; tap-to-play: root.tap-to-play;
                            activate => { root.browse-action(true, i, 0); keyboard.focus(); }
                            pointer-activate => { root.browse-action(true, i, 3); keyboard.focus(); }
                            play => { root.browse-action(true, i, 1); }
                            enqueue => { root.browse-action(true, i, 2); }
                            artist(name) => { root.open-artist(name); keyboard.focus(); }
                        }
                    }
                    if root.show-disc-selector && !root.artist-view && root.collector-active && !(root.show-queue && root.adhoc-queue && !root.artist-view): ComboBox { model: root.album-sources; current-index <=> root.album-source-index; selected(_) => { root.album-source-selected(self.current-index); } }
                    if !root.artist-view && !(root.show-queue && root.adhoc-queue && !root.artist-view): HorizontalLayout {
                        spacing: 6px; alignment: start;
                        IconButton { label: "Play album"; icon: @image-url("icons/play.svg"); enabled: !root.collector-album-loading && root.tracks.length > 0 && !root.album-ambiguous; clicked => { root.play-album(); } }
                        if root.collector-active: IconButton { label: "Download album"; icon: @image-url("icons/download.svg"); enabled: !root.collector-album-loading && !root.collector-busy && root.collector-online; clicked => { root.download-action(0); } }
                        if root.collector-active: IconButton { label: "Download track"; icon: @image-url("icons/download-track.svg"); enabled: !root.collector-busy && root.collector-online && root.selected-track >= 0; clicked => { root.download-action(6); } }
                        if root.collector-active: IconButton { label: "Remove download"; icon: @image-url("icons/remove-download.svg"); clicked => { root.download-action(1); } }
                        if !root.wide: Rectangle { horizontal-stretch: 1; }
                        if !root.wide: IconButton { label: "Home"; icon: @image-url("icons/home.svg"); clicked => { root.home = true; keyboard.focus(); } }
                    }
                    if !root.artist-view && !(root.show-queue && root.adhoc-queue) && root.album-matching-available && root.selected-album >= 0: Button {
                        text: "Find matching albums";
                        clicked => { root.album-matching-open = true; root.find-album-matches(); }
                    }
                    if !root.artist-view: HorizontalLayout {
                        spacing: 0px;
                        for label[i] in ["Tracks", "Up next (" + root.queued.length + ")"] : tab := FocusScope {
                            horizontal-stretch: 1; min-width: 100px;
                            height: 34px;
                            accessible-role: AccessibleRole.tab;
                            accessible-label: label + (root.show-queue == (i == 1) ? ", selected" : "");
                            key-pressed(event) => {
                                if (event.text == " " || event.text == Key.Return) { root.show-queue = i == 1; return accept; }
                                if (event.text == Key.LeftArrow || event.text == Key.RightArrow) { root.show-queue = !root.show-queue; return accept; }
                                return reject;
                            }
                            accessible-action-default => { root.show-queue = i == 1; }
                            Text { width: 100%; height: 100%; text: label; color: root.show-queue == (i == 1) ? Theme.text : Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                            Rectangle { y: parent.height - 2px; height: 2px; width: 100%; background: root.show-queue == (i == 1) ? Theme.accent : Theme.hover; }
                            TouchArea { clicked => { root.show-queue = i == 1; tab.focus(); } }
                        }
                    }
                    if !root.show-queue && !root.artist-view: track-focus := FocusScope {
                        min-height: root.short ? 48px * root.text-scale : 0px; preferred-height: 0px; vertical-stretch: 1;
                        enabled: root.tracks.length > 0;
                        focus-on-click: false;
                        focus-gained(_) => {
                            root.move-album-track-selection(0, track-list.visible-height);
                            if root.short {
                                details.content-y = max(-self.y, min(details.content-y,
                                    details.visible-height - self.y - self.height));
                            }
                        }
                        key-pressed(event) => {
                            if event.modifiers.control || event.modifiers.meta || event.modifiers.alt { return reject; }
                            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                                if !self.has-focus { self.focus(); }
                                root.move-album-track-selection(event.text == Key.UpArrow ? -1 : 1, track-list.visible-height);
                                return accept;
                            }
                            if event.text == Key.Return && root.selected-track >= 0 {
                                if !event.repeat { root.play-track(root.selected-track); }
                                return accept;
                            }
                            return reject;
                        }
                        track-list := ListView {
                            width: 100%; height: 100%;
                            accessible-label: "Album tracks";
                            content-y <=> root.track-y;
                            for track[i] in root.tracks: TrackItem {
                                track: track; text-scale: root.text-scale; tap-to-play: root.tap-to-play;
                                selected: i == root.selected-track; current: i == root.active-track;
                                keyboard-selected: track-focus.has-focus && self.selected;
                                select => { root.selected-track = i; root.album-track-selected(); track-focus.focus(); }
                                play => { root.selected-track = i; root.play-track(i); track-focus.focus(); }
                                enqueue => { root.enqueue(i); }
                            }
                        }
                    }
                    if root.show-queue && !root.artist-view: VerticalLayout {
                        IconButton { label: "Clear up next"; icon: @image-url("icons/trash.svg"); clicked => { root.clear-queue(); } }
                        ListView {
                            min-height: root.short ? 48px * root.text-scale : 0px; preferred-height: 0px; vertical-stretch: 1;
                            for title in root.queued: Text { text: title; color: Theme.text; height: 34px; overflow: elide; }
                        }
                    }
                }
            }
        }
        if root.source-loading: Rectangle {
            vertical-stretch: 0;
            background: Theme.surface; border-radius: 6px;
            accessible-role: region; accessible-label: "Library loading progress";
            VerticalLayout {
                padding: 8px; spacing: 6px;
                Text {
                    text: root.source-progress-message;
                    color: Theme.text; wrap: word-wrap;
                    font-size: 12px * root.text-scale;
                    accessible-live-region: polite;
                }
                ProgressIndicator {
                    height: 4px;
                    progress: root.source-progress;
                    indeterminate: root.source-progress-indeterminate;
                    accessible-label: "Current library page";
                }
            }
        }
        if root.loading-files: FileLoadingStatus {
            message: root.loading-message; path: root.loading-path; compact: root.short;
            cancelled => { root.cancel-file-load(); }
        }
        if root.scan-summary != "" && !root.settings && !root.lists-open: Rectangle {
            vertical-stretch: 0;
            background: Theme.surface;
            border-radius: 6px;
            accessible-role: groupbox;
            accessible-label: "Folder refresh status";
            VerticalLayout {
                padding: 8px; spacing: 4px;
                Text { text: root.scan-summary; color: Theme.muted; wrap: word-wrap; font-size: 12px * root.text-scale; accessible-live-region: polite; }
                // Stack the actions when wide system fonts (e.g. DejaVu Sans) would overflow a narrow window.
                if root.width >= 360px * root.text-scale: HorizontalLayout {
                    spacing: 8px;
                    Button { text: root.scan-details-open ? "Hide details" : "View details"; clicked => { root.scan-details-open = !root.scan-details-open; } }
                    Button { text: root.scanning ? "Refreshing…" : "Retry refresh"; enabled: !root.scanning; clicked => { root.refresh-folder(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.width < 360px * root.text-scale: VerticalLayout {
                    spacing: 4px;
                    Button { text: root.scan-details-open ? "Hide details" : "View details"; clicked => { root.scan-details-open = !root.scan-details-open; } }
                    Button { text: root.scanning ? "Refreshing…" : "Retry refresh"; enabled: !root.scanning; clicked => { root.refresh-folder(); } }
                }
                if root.scan-details-open: ScrollView {
                    height: min(140px, root.height / 4);
                    content-height: max(self.visible-height, scan-detail-text.preferred-height);
                    scan-detail-text := Text {
                        width: parent.width;
                        text: root.scan-details;
                        color: Theme.muted;
                        wrap: word-wrap;
                        font-size: 12px * root.text-scale;
                    }
                }
            }
        }
        playback-dock := Rectangle {
            accessible-role: region; accessible-label: "Playback dock";
            // The dock continues behind the home indicator. Only its foreground
            // consumes the bottom inset, once; no floating card above an empty chin.
            height: root.short ? transport-content.min-height : max(104px * root.text-scale + root.dock-bottom-inset, transport-content.min-height);
            background: Theme.transport; border-radius: root.edge-to-edge ? 0px : 9px;
            transport-content := VerticalLayout {
                padding: root.wide ? 8px : 16px;
                padding-top: root.short ? 4px : (root.wide ? 8px : 12px);
                padding-bottom: max(root.short ? 4px : 8px, root.dock-bottom-inset);
                spacing: 4px;
                HorizontalLayout {
                    spacing: 10px;
                    TransportButton { icon: @image-url("icons/previous.svg"); label: "Previous track"; button-size: root.touch-input ? 44px : 40px; clicked => { root.previous(); } }
                    TransportButton {
                        width: 48px; height: root.touch-input ? 44px : 40px;
                        primary: true;
                        icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                        label: root.playing ? "Pause" : "Play";
                        clicked => { root.toggle-play(); }
                    }
                    TransportButton { icon: @image-url("icons/next.svg"); label: "Next track"; button-size: root.touch-input ? 44px : 40px; clicked => { root.next(); } }
                    VerticalLayout {
                        Text { text: root.now-title; color: Theme.text; overflow: elide; font-weight: 600; }
                        Text { text: root.now-artist; color: Theme.muted; overflow: elide; font-size: 12px * root.text-scale; }
                    }
                    if root.wide: Rectangle {
                        width: 68px; background: Theme.divider;
                        Rectangle { y: parent.height * (1 - root.level); height: parent.height * root.level; width: parent.width; background: Theme.accent; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.elapsed; color: Theme.muted; width: max(40px * root.text-scale, self.preferred-width); vertical-alignment: center; }
                    playhead := TransportSeek { touch-input: root.touch-input; position <=> root.progress; seek(v) => { root.seek(v); } }
                    Text { text: root.duration; color: Theme.muted; width: max(40px * root.text-scale, self.preferred-width); vertical-alignment: center; horizontal-alignment: right; }
                }
                if root.scanning && !root.source-loading: Rectangle {
                    height: 3px; background: Theme.hover;
                    Rectangle { height: 100%; width: parent.width * root.scan-progress; background: Theme.accent; }
                }
                HorizontalLayout {
                    height: max(connection-control.height, playback-status.preferred-height); spacing: 6px;
                    // Balance the connection icon so multiline phone status stays
                    // centered and clear of the display's lower corner curves.
                    if root.edge-to-edge: Rectangle { width: connection-control.width; }
                    playback-status := Text {
                        text: root.status; color: Theme.muted;
                        wrap: root.edge-to-edge && !root.short ? TextWrap.word-wrap : TextWrap.no-wrap;
                        overflow: root.edge-to-edge && !root.short ? TextOverflow.clip : TextOverflow.elide;
                        horizontal-alignment: root.edge-to-edge ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
                        vertical-alignment: center; font-size: 11px * root.text-scale;
                        accessible-label: "Playback status"; horizontal-stretch: 1;
                    }
                    connection-control := ConnectionIndicator { kind: root.connection-kind; touch-input: root.touch-input; text-scale: root.text-scale; available-width: parent.width; }
                }
            }
        }

    }
    }
    if root.drop-hovered && !root.loading-files: Rectangle {
        background: #0009; border-width: 3px; border-color: Theme.accent;
        Text {
            text: "Drop music files or folders to play"; color: Theme.text;
            horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
            font-size: 24px;
        }
    }
    error-dialog := ErrorDialog {
        visible: root.error-message != "";
        x: root.safe-area-insets.left; y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        title: root.error-title; message: root.error-message;
        dismissed => { root.error-message = ""; }
    }
    if root.album-matching-open: Rectangle {
        x: root.safe-area-insets.left + max(8px, (keyboard.width - self.width) / 2);
        y: root.safe-area-insets.top + 8px;
        width: min(keyboard.width - 16px, 760px);
        height: max(0px, min(root.height - root.safe-area-insets.bottom, keyboard.y + keyboard.height) - self.y - 8px);
        background: Theme.raised; border-color: Theme.muted; border-width: 1px; border-radius: 8px;
        VerticalLayout {
            padding: 12px; spacing: 8px;
            HorizontalLayout {
                Text { text: "Matching local albums"; color: Theme.text; font-weight: 600; font-size: 20px * root.text-scale; wrap: word-wrap; horizontal-stretch: 1; }
                Button { text: "Close"; clicked => { root.album-matching-open = false; } }
            }
            Text { text: root.album-matching-status; color: Theme.text; wrap: word-wrap; }
            Text { text: "Review coverage and track assignments. These are identity suggestions, not catalog verification. Existing names and original files are preserved."; color: Theme.muted; wrap: word-wrap; }
            if root.album-matching-busy: Button { text: "Cancel matching"; clicked => { root.cancel-album-matching(); } }
            ScrollView {
                vertical-stretch: 1; min-height: 0px;
                VerticalLayout {
                    spacing: 12px;
                    for candidate in root.album-matching-rows: Rectangle {
                        background: Theme.raised; border-radius: 4px;
                        HorizontalLayout {
                            padding: 8px; spacing: 10px;
                            Image { source: candidate.artwork; width: 64px; height: 64px; image-fit: contain; }
                            VerticalLayout {
                                Text { text: candidate.title; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                                Text { text: candidate.artist; color: Theme.text; wrap: word-wrap; }
                                Text { text: candidate.detail; color: Theme.muted; wrap: word-wrap; }
                                Text { text: candidate.tracks; color: Theme.text; wrap: word-wrap; }
                                Button { text: candidate.applicable ? "Use this album" : "Needs manual mapping";
                                    enabled: candidate.applicable && !root.album-matching-busy;
                                    clicked => { root.apply-album-match(candidate.release); } }
                            }
                        }
                    }
                }
            }
        }
    }

}
