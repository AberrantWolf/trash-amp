import { Slider, CheckBox } from "themed-controls.slint";
import { IconButton, ButtonHints } from "icon-button.slint";
export { ButtonHints }
import { TransportButton } from "transport-button.slint";
import { Theme } from "theme.slint";
import { Palette, Button, ScrollView, ListView, AboutSlint, ComboBox, LineEdit } from "std-widgets.slint";
import { BrowserItem, BrowserRow } from "browser-item.slint";
export { BrowserRow }
import { TrackItem, TrackRow } from "track-item.slint";
export { TrackRow }
import { TransportSeek } from "transport-seek.slint";
import { ErrorDialog } from "error-dialog.slint";
import { ConnectionIndicator, ConnectionKind } from "connection-indicator.slint";
export { ConnectionKind }
export component PlayerWindow inherits Window {
    in-out property <string> error-title: "Connection failed";
    in-out property <string> error-message;
    changed error-message => {
        if root.error-message != "" { error-dialog.take-focus(); }
        else { keyboard.focus(); }
    }
    in property <ConnectionKind> connection-kind;
    icon: @image-url("../../../assets/macos/trash-amp.png");
    in property <[string]> sources;
    in-out property <int> source-index;
    callback source-changed(int);
    in-out property <bool> lists-open;
    in-out property <int> settings-tab;
    in-out property <string> server-url;
    in-out property <string> certificate-path;
    in property <string> connection-status;
    in property <bool> collector-active;
    in property <bool> collector-online;
    in property <bool> collector-busy;
    in property <bool> removing-connection;
    in property <[string]> collections;
    in-out property <int> collection-index;
    callback collection-changed(int);
    in property <[string]> saved-lists;
    in-out property <int> list-index: -1;
    callback list-selected(int);
    in property <[BrowserRow]> list-rows;
    in-out property <int> list-entry: -1;
    in property <bool> list-editable;
    in-out property <string> list-name;
    in-out property <string> download-budget: "10";
    in property <image> album-art;
    in property <[string]> album-sources;
    in-out property <int> album-source-index;
    in property <bool> album-ambiguous;
    callback album-source-selected(int);
    callback connect-server(); callback cancel-connect(); callback refresh-server(); callback remove-server();
    callback list-command(int); callback play-list(bool); callback play-list-from(int); callback download-action(int); callback save-budget();
    title: "Trash Amp";
    in property <string> application-version;
    preferred-width: 980px; preferred-height: 680px; min-width: 330px; min-height: 230px; max-width: 10000px; max-height: 10000px;
    background: Theme.canvas;
    default-font-family: "Helvetica Neue";
    default-font-size: 14px * root.text-scale;
    in-out property <float> text-scale: 1;
    in-out property <int> audio-buffer-seconds: 15;
    in property <[TrackRow]> tracks;
    in property <[string]> queued;
    in property <string> album-title: "Your albums, close at hand.";
    in property <string> album-artist: "Open a music folder to begin.";
    in property <string> now-title: "Nothing playing";
    in property <string> now-artist;
    in property <string> status: "Choose a folder, including a mounted network drive.";
    in property <string> elapsed: "0:00";
    in property <string> duration: "0:00";
    in property <bool> playing;
    in-out property <float> progress;
    out property <bool> scrubbing: playhead.scrubbing;
    in property <float> level;
    in property <bool> scanning;
    in property <float> scan-progress;
    in property <[BrowserRow]> browser-rows;
    in property <[BrowserRow]> artist-rows;
    in property <bool> artist-view;
    in property <bool> can-back;
    in property <bool> section-open;
    in property <int> browser-selected: -1;
    in-out property <length> browser-y;
    in-out property <length> detail-y;
    in-out property <length> track-y;
    in-out property <string> search-text;
    in-out property <bool> search-editing;
    in-out property <bool> focus-search;
    callback search-changed();
    callback focus-search-requested();
    callback browse-action(bool, int, int);
    callback open-artist(string);
    callback back();
    callback activate-selection();
    callback album-track-selected();
    in-out property <int> sort-order;
    callback sort-changed();
    in-out property <int> selected-track: -1;
    in property <int> selected-album: -1;
    in property <int> active-track: -1;
    in-out property <bool> dark-mode <=> Theme.dark;
    in-out property <bool> oled-mode <=> Theme.oled;
    init => { Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light; }
    changed dark-mode => { Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light; }
    in-out property <bool> reduced-motion;
    in-out property <bool> prefer-raw: true;
    in-out property <bool> automatic-metadata: true;
    in-out property <bool> settings;
    // Launch routing is supplied by the host; returning Home preserves browse state.
    in-out property <bool> home;
    changed home => {
        if root.home { root.settings = false; root.lists-open = false; root.search-editing = false; }
    }
    in-out property <bool> show-library: true;
    in-out property <bool> show-queue;
    // Store the desktop choice independently of the temporary phone layout.
    in-out property <float> library-width: 280;
    // Snapshot the viewport to keep layout constraints independent of Window's layout hints.
    private property <length> viewport-width: 980px;
    changed width => { root.viewport-width = self.width; }
    private property <length> desktop-library-width: min(max(220px * root.text-scale, root.library-width * root.text-scale * 1px), root.viewport-width * 0.45);
    in property <bool> wide: true;
    in property <bool> touch-input;
    out property <bool> tap-to-play: root.touch-input || !root.wide;
    in property <bool> short: false;
    changed short => { if root.short { root.search-editing = false; } }
    changed settings => { if root.settings { root.search-editing = false; root.lists-open = false; root.home = false; } }
    changed lists-open => { if root.lists-open { root.search-editing = false; root.settings = false; root.home = false; } }
    changed show-library => { if !root.show-library && !root.wide { root.search-editing = false; } }
    changed wide => { if !root.wide && !root.show-library { root.search-editing = false; } }
    in property <bool> can-open-folder: true;
    callback open-folder(); callback demo();
    in property <[string]> folder-libraries;
    in-out property <int> folder-index: -1;
    callback folder-selected(int);
    callback refresh-folder();
    callback play-track(int); callback enqueue(int); callback toggle-play();
    callback previous(); callback next(); callback seek(float);
    callback preferences-changed(); callback clear-queue();
    forward-focus: keyboard;
    keyboard := FocusScope {
      enabled: root.error-message == "";
      x: root.safe-area-insets.left;
      y: root.safe-area-insets.top;
      width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
      height: max(0px, min(root.height - root.safe-area-insets.bottom,
          root.virtual-keyboard-size.height > 0px ? root.virtual-keyboard-position.y : root.height)
          - root.safe-area-insets.top);
      key-pressed(event) => {
        if ((event.modifiers.control || event.modifiers.meta) && (event.text == "f" || event.text == "F")) {
            root.focus-search-requested(); return accept;
        }
        if (root.search-editing) { return reject; }
        if (!root.settings && !root.lists-open && !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta) {
            if (event.text == " ") { root.toggle-play(); return accept; }
            if (event.text == Key.LeftArrow) { root.previous(); return accept; }
            if (event.text == Key.RightArrow) { root.next(); return accept; }
        }
        if (event.text == Key.Escape && (root.settings || root.lists-open)) { root.home = true; keyboard.focus(); return accept; }
        if (event.text == Key.Escape && root.home) { root.home = false; keyboard.focus(); return accept; }
        if (event.text == Key.Return && !root.home && !root.settings && !root.lists-open) { root.activate-selection(); return accept; }
        return reject;
      }
      VerticalLayout {
        padding: 16px; spacing: 8px;
        // Source and library selection live on Home, never above the track list.
        if root.settings || root.lists-open: HorizontalLayout {
            height: 44px; spacing: 8px;
            IconButton { label: "Home"; icon: @image-url("icons/home.svg"); clicked => { root.home = true; keyboard.focus(); } }
            Text { text: root.settings ? "Settings" : "Lists"; color: Theme.text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        }
        if root.home: Rectangle {
            accessible-role: groupbox; accessible-label: "Home page";
            background: Theme.surface; border-radius: 6px;
            home-scroll := ScrollView {
                mouse-drag-pan-enabled: true;
                width: 100%; height: 100%;
                content-width: self.visible-width;
                content-height: max(self.visible-height, home-content.min-height);
                home-content := VerticalLayout {
                    x: max(0px, (home-scroll.visible-width - self.width) / 2);
                    width: min(home-scroll.visible-width, 560px);
                    height: home-scroll.content-height;
                    padding: root.wide ? 24px : 12px; spacing: 16px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Home"; color: Theme.text; font-size: 27px * root.text-scale; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton { label: "Settings"; icon: @image-url("icons/settings.svg"); clicked => { root.settings = true; keyboard.focus(); } }
                    }
                    Text { text: "Choose your music"; color: Theme.muted; wrap: word-wrap; }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Source"; color: Theme.text; font-weight: 600; }
                        ComboBox { model: root.sources; current-index <=> root.source-index; accessible-label: "Music source"; min-height: 44px;
                            selected(i) => { root.source-changed(self.current-index); } }
                    }
                    if root.collector-active: VerticalLayout {
                        spacing: 6px;
                        Text { text: "Library"; color: Theme.text; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 6px;
                            ComboBox { model: root.collections; current-index <=> root.collection-index; accessible-label: "Music collection"; horizontal-stretch: 1;
                                selected(i) => { root.collection-changed(self.current-index); } }
                            IconButton { label: "Refresh"; icon: @image-url("icons/refresh.svg"); enabled: !root.collector-busy; clicked => { root.refresh-server(); } }
                        }
                        Text { text: root.connection-status; color: Theme.muted; wrap: word-wrap; }
                    }
                    if !root.collector-active && root.folder-libraries.length > 0: VerticalLayout {
                        spacing: 6px;
                        Text { text: "Folder library"; color: Theme.text; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 6px;
                            ComboBox { model: root.folder-libraries; current-index <=> root.folder-index; accessible-label: "Saved folder library"; horizontal-stretch: 1;
                                selected(i) => { root.folder-selected(self.current-index); } }
                            IconButton { label: "Refresh folder"; icon: @image-url("icons/refresh.svg"); enabled: root.folder-index >= 0 && !root.scanning; clicked => { root.refresh-folder(); } }
                        }
                    }
                    if !root.collector-active && root.folder-libraries.length == 0: Text {
                        text: root.can-open-folder ? "Open a music folder to start a local library." : "Add a server to start listening.";
                        color: Theme.muted; wrap: word-wrap;
                    }
                    Button { text: "Browse library"; accessible-label: "Browse library"; min-height: 44px;
                        clicked => { root.home = false; keyboard.focus(); } }
                    if root.collector-active: Button { text: "Lists"; accessible-label: "Lists"; min-height: 44px;
                        clicked => { root.lists-open = true; keyboard.focus(); } }
                    Rectangle { height: 1px; background: Theme.divider; }
                    if root.can-open-folder: Button { text: "Open folder"; accessible-label: "Open folder"; min-height: 44px;
                        clicked => { root.open-folder(); } }
                    Button { text: "Add / manage servers"; accessible-label: "Manage servers"; min-height: 44px;
                        clicked => { root.settings-tab = 1; root.settings = true; keyboard.focus(); } }
                    Rectangle { min-height: 0px; vertical-stretch: 1; }
                }
            }
        }
        if root.lists-open: Rectangle {
            background: Theme.surface; border-radius: 6px;
            collector-scroll := ScrollView {
                mouse-drag-pan-enabled: true;
                width: 100%; height: 100%;
                viewport-width: max(self.visible-width, collector-content.min-width);
                viewport-height: max(self.visible-height, collector-content.min-height);
                collector-content := VerticalLayout {
                width: collector-scroll.viewport-width; height: collector-scroll.viewport-height;
                padding: 12px; spacing: 8px;
                Text { text: "Lists"; color: Theme.text; font-size: 20px * root.text-scale; font-weight: 600; }
                Text { text: root.connection-status; color: Theme.muted; wrap: word-wrap; }
                HorizontalLayout {
                    ComboBox { model: root.saved-lists; current-index <=> root.list-index; selected(i) => { root.list-selected(self.current-index); } }
                    IconButton { label: "Play"; icon: @image-url("icons/play.svg"); enabled: root.list-index > 0; clicked => { root.play-list(false); } }
                    IconButton { label: "Shuffle"; icon: @image-url("icons/shuffle.svg"); enabled: root.list-index > 0; clicked => { root.play-list(true); } }
                    IconButton { label: "Download list"; icon: @image-url("icons/download.svg"); enabled: !root.collector-busy && root.collector-online && root.list-index > 0; clicked => { root.download-action(2); } }
                    IconButton { label: "Remove list downloads"; icon: @image-url("icons/remove-download.svg"); enabled: root.list-index > 0; clicked => { root.download-action(3); } }
                }
                HorizontalLayout {
                    LineEdit { text <=> root.list-name; placeholder-text: "List name"; accessible-label: "List name"; }
                    IconButton { label: "Create"; icon: @image-url("icons/plus.svg"); enabled: !root.collector-busy && root.collector-online && root.list-editable; clicked => { root.list-command(0); } }
                    IconButton { label: "Rename"; icon: @image-url("icons/edit.svg"); enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-index > 0; clicked => { root.list-command(1); } }
                    IconButton { label: "Delete"; icon: @image-url("icons/trash.svg"); enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-index > 0; clicked => { root.list-command(2); } }
                }
                HorizontalLayout {
                    Button { text: "Append album"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.selected-album >= 0; clicked => { root.list-command(3); } }
                    Button { text: "Append disc"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.selected-album >= 0; clicked => { root.list-command(10); } }
                    Button { text: "Append track"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.selected-track >= 0; clicked => { root.list-command(4); } }
                    Button { text: "Remove entry"; enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-entry >= 0; clicked => { root.list-command(5); } }
                    IconButton { label: "Move up"; icon: @image-url("icons/up.svg"); enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-entry > 0; clicked => { root.list-command(6); } }
                    IconButton { label: "Move down"; icon: @image-url("icons/down.svg"); enabled: !root.collector-busy && root.collector-online && root.list-editable && root.list-entry >= 0; clicked => { root.list-command(7); } }
                }
                HorizontalLayout {
                    Button { text: "Retry original changes"; enabled: !root.collector-busy && root.collector-online; clicked => { root.list-command(8); } }
                    Button { text: "Discard unresolved changes"; clicked => { root.list-command(9); } }
                }
                ListView {
                    min-height: 180px; vertical-stretch: 1;
                    for item[i] in root.list-rows: BrowserItem { item: item; selected: i == root.list-entry; tap-to-play: root.tap-to-play;
                        activate => { root.list-entry = i; if root.tap-to-play { root.play-list-from(i); } }
                        pointer-activate => { root.list-entry = i; if root.tap-to-play { root.play-list-from(i); } }
                    }
                }
            }
            }
        }
        if root.settings: Rectangle {
            background: Theme.raised; border-radius: 8px;
            settings-scroll := ScrollView {
                mouse-drag-pan-enabled: true;
                width: 100%; height: 100%;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, settings-content.min-height);
                settings-content := VerticalLayout {
                    width: settings-scroll.visible-width;
                    height: settings-scroll.viewport-height;
                    padding: 12px; spacing: 12px;
                    Text { text: "Settings"; color: Theme.text; font-size: 20px * root.text-scale; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "General"; enabled: root.settings-tab != 0; clicked => { root.settings-tab = 0; } }
                        Button { text: "Servers"; enabled: root.settings-tab != 1; clicked => { root.settings-tab = 1; } }
                        Button { text: "Downloads"; enabled: root.settings-tab != 2; clicked => { root.settings-tab = 2; } }
                    }
                    if root.settings-tab == 0: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Appearance"; color: Theme.text; vertical-alignment: center; }
                            ComboBox { model: ["Light", "Dark"]; current-index: root.dark-mode ? 1 : 0;
                                accessible-label: "Color mode";
                                selected(_) => { root.dark-mode = self.current-index == 1; root.preferences-changed(); } }
                        }
                        CheckBox { text: "OLED black backgrounds"; checked <=> root.oled-mode;
                            toggled => { root.preferences-changed(); } }
                        Text { text: "Use pure black backgrounds in dark mode."; color: Theme.muted; wrap: word-wrap; }
                        CheckBox { text: "Prefer redumper raw dumps"; checked <=> root.prefer-raw;
                            toggled => { root.preferences-changed(); } }
                        CheckBox { text: "Automatic metadata from MusicBrainz"; checked <=> root.automatic-metadata;
                            toggled => { root.preferences-changed(); } }
                        HorizontalLayout {
                            Text { text: "Audio buffer: " + root.audio-buffer-seconds + " s"; color: Theme.text; }
                            Slider { minimum: 3; maximum: 60; step: 1; value: root.audio-buffer-seconds;
                                changed(v) => { root.audio-buffer-seconds = round(v); root.preferences-changed(); } }
                        }
                        Text { text: "More buffer helps with network dropouts and uses more memory. Restart the app to apply changes."; color: Theme.muted; wrap: word-wrap; }
                        CheckBox { text: "Reduce motion"; checked <=> root.reduced-motion;
                            toggled => { root.preferences-changed(); } }
                        Button { text: "Load 2,000-album layout demo"; clicked => { root.demo(); root.settings = false; } }
                        HorizontalLayout {
                            Text { text: "Text size"; color: Theme.text; }
                            Slider { minimum: 1; maximum: 1.6; value: root.text-scale;
                                changed(v) => { root.text-scale = v; root.preferences-changed(); } }
                        }
                    }
                    if root.settings-tab == 1: VerticalLayout {
                        spacing: 10px;
                        Text { text: "Servers"; color: Theme.text; font-weight: 600; }
                        ComboBox { model: root.sources; current-index <=> root.source-index; accessible-label: "Server to manage"; selected(i) => { root.source-changed(self.current-index); } }
                        LineEdit { text <=> root.server-url; placeholder-text: "https://collector.example:8443"; accessible-label: "Collector server URL"; }
                        HorizontalLayout {
                            Button { text: "Connect / Reconnect"; enabled: !root.collector-busy; clicked => { root.connect-server(); } }
                            Button { text: "Cancel"; enabled: root.collector-busy; clicked => { root.cancel-connect(); } }
                        }
                        LineEdit { text <=> root.certificate-path; placeholder-text: "Optional owner-provided PEM or pairing JSON path"; accessible-label: "Owner-provided trust file"; }
                        Text { text: root.connection-status; color: Theme.text; wrap: word-wrap; }
                        Button { text: root.removing-connection ? "Removing connection…" : "Remove connection"; enabled: root.collector-active && !root.collector-busy && !root.removing-connection; clicked => { root.remove-server(); } }
                    }
                    if root.settings-tab == 2: VerticalLayout {
                        spacing: 10px;
                        Text { text: "Downloads"; color: Theme.text; font-weight: 600; }
                        Text { text: "Audio storage limit (GiB)"; color: Theme.muted; }
                        HorizontalLayout {
                            LineEdit { text <=> root.download-budget; placeholder-text: "Audio budget (GiB)"; accessible-label: "Download budget in GiB"; }
                            Button { text: "Set GiB limit"; clicked => { root.save-budget(); } }
                        }
                        HorizontalLayout {
                            Button { text: "Retry downloads"; clicked => { root.download-action(4); } }
                            Button { text: "Cancel downloads"; clicked => { root.download-action(5); } }
                        }
                        Text { text: root.connection-status; color: Theme.muted; wrap: word-wrap; }
                    }
                    Rectangle { min-height: 12px; vertical-stretch: 1; }
                    if root.settings-tab == 0: HorizontalLayout {
                        alignment: center;
                        AboutSlint { width: 240px; height: 112px; }
                    }
                    if root.settings-tab == 0: Text { text: "Trash Amp " + root.application-version; color: Theme.muted; horizontal-alignment: center; }
                }
            }
        }
        if !root.home && !root.short && !root.settings && !root.lists-open: HorizontalLayout {
            spacing: 0px;
            if root.wide || root.show-library: Rectangle {
                accessible-role: groupbox;
                accessible-label: "Album browser";
                preferred-width: root.wide ? root.desktop-library-width : 280px;
                max-width: root.wide ? root.desktop-library-width : 10000px;
                min-width: root.wide ? root.desktop-library-width : 0px;
                horizontal-stretch: root.wide ? 0 : 1;
                background: Theme.surface; border-radius: 6px;
                HorizontalLayout {
                    x: 8px; y: 8px; width: parent.width - 16px; height: 44px; spacing: 6px;
                    IconButton { label: "Home"; icon: @image-url("icons/home.svg"); clicked => { root.home = true; keyboard.focus(); } }
                    ComboBox { model: ["Albums", "Artists"]; current-index <=> root.sort-order; selected(_) => { root.sort-changed(); } }
                    if root.section-open: IconButton { label: "Back"; icon: @image-url("icons/back.svg"); button-size: 32px; clicked => { root.back(); keyboard.focus(); } }
                }
                search-bar := HorizontalLayout {
                    x: 8px; y: root.wide ? 58px : parent.height - self.height - 8px;
                    width: parent.width - 16px; height: 36px * root.text-scale; spacing: 4px;
                    search := LineEdit {
                        in-out property <bool> request-focus <=> root.focus-search;
                        changed request-focus => { if self.request-focus { self.focus(); self.request-focus = false; } }
                        init => { if self.request-focus { self.focus(); self.request-focus = false; } }
                        changed has-focus => { root.search-editing = self.has-focus; }
                        placeholder-text: "Search library"; accessible-label: "Search library";
                        text <=> root.search-text;
                        edited(_) => { root.search-changed(); }
                        key-pressed(event) => {
                            if event.text == Key.Escape { keyboard.focus(); return accept; }
                            return reject;
                        }
                    }
                    if root.search-text != "": IconButton { label: "Clear search"; icon: @image-url("icons/close.svg"); button-size: 36px;
                        clicked => { root.search-text = ""; root.search-changed(); search.focus(); } }
                }
                list := ListView {
                    x: 8px; y: root.wide ? 64px + search-bar.height : 58px;
                    width: parent.width - 16px;
                    height: parent.height - 72px - search-bar.height;
                    viewport-y <=> root.browser-y;
                    for item[i] in root.browser-rows: BrowserItem {
                        item: item; text-scale: root.text-scale; selected: root.browser-selected == i; tap-to-play: root.tap-to-play;
                        activate => { root.browse-action(false, i, 0); keyboard.focus(); }
                        pointer-activate => { root.browse-action(false, i, 3); keyboard.focus(); }
                        play => { root.browse-action(false, i, 1); }
                        enqueue => { root.browse-action(false, i, 2); }
                        artist(name) => { root.open-artist(name); keyboard.focus(); }
                    }
                }
            }

            if root.wide: FocusScope {
                width: 16px;
                accessible-role: slider;
                accessible-label: "Resize album browser";
                key-pressed(event) => {
                    if (event.text == Key.LeftArrow) { root.library-width = max(220, root.library-width - 20); return accept; }
                    if (event.text == Key.RightArrow) { root.library-width = min(root.viewport-width * 0.45 / (root.text-scale * 1px), root.library-width + 20); return accept; }
                    return reject;
                }
                Rectangle { x: 7px; width: 2px; height: 100%; background: resize.has-hover || resize.pressed ? Theme.accent : Theme.divider; }
                resize := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        if (self.pressed) {
                            root.library-width = min(max(220, (root.desktop-library-width + self.mouse-x - self.pressed-x) / (root.text-scale * 1px)), root.viewport-width * 0.45 / (root.text-scale * 1px));
                        }
                    }
                    double-clicked => { root.library-width = 280; }
                }
            }
            if root.wide || !root.show-library: VerticalLayout {
                min-width: 0px; horizontal-stretch: 1;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    if !root.wide || root.can-back: IconButton { label: "Back"; icon: @image-url("icons/back.svg"); clicked => { root.back(); keyboard.focus(); } }
                    Image { source: root.album-art; width: root.wide ? 64px : 48px; height: self.width; image-fit: contain; }
                    Text { text: root.album-title; color: Theme.text; font-size: (root.wide ? 27px : 22px) * root.text-scale; font-weight: 600; wrap: word-wrap; }
                    if root.artist-view && !root.wide: IconButton { label: "Home"; icon: @image-url("icons/home.svg"); clicked => { root.home = true; keyboard.focus(); } }
                }
                if root.artist-view: Text { text: root.album-artist; color: Theme.muted; wrap: word-wrap; }
                if !root.artist-view: artist-link := FocusScope {
                    enabled: root.tracks.length > 0;
                    height: 24px * root.text-scale;
                    accessible-role: button; accessible-label: "Artist: " + root.album-artist;
                    accessible-action-default => { root.open-artist(root.album-artist); }
                    key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.open-artist(root.album-artist); return accept; } return reject; }
                    Text { x: 0px; y: 0px; width: 100%; height: 100%; horizontal-alignment: left; text: root.album-artist; color: Theme.link; overflow: elide; font-weight: artist-link.has-focus || artist-click.has-hover ? 600 : 400; }
                    artist-click := TouchArea { clicked => { root.open-artist(root.album-artist); keyboard.focus(); } }
                }
                if root.artist-view: ListView {
                    accessible-label: "Artist releases";
                    min-height: 0px; preferred-height: 0px; vertical-stretch: 1;
                    viewport-y <=> root.detail-y;
                    for item[i] in root.artist-rows: BrowserItem {
                        item: item; text-scale: root.text-scale; show-album: false; tap-to-play: root.tap-to-play;
                        activate => { root.browse-action(true, i, 0); keyboard.focus(); }
                        pointer-activate => { root.browse-action(true, i, 3); keyboard.focus(); }
                        play => { root.browse-action(true, i, 1); }
                        enqueue => { root.browse-action(true, i, 2); }
                        artist(name) => { root.open-artist(name); keyboard.focus(); }
                    }
                }
                if !root.artist-view && root.collector-active: ComboBox { model: root.album-sources; current-index <=> root.album-source-index; selected(_) => { root.album-source-selected(self.current-index); } }
                if !root.artist-view: HorizontalLayout {
                    spacing: 6px; alignment: start;
                    IconButton { label: "Play album"; icon: @image-url("icons/play.svg"); enabled: root.tracks.length > 0 && !root.album-ambiguous; clicked => { root.play-track(0); } }
                    if root.collector-active: IconButton { label: "Download album"; icon: @image-url("icons/download.svg"); enabled: !root.collector-busy && root.collector-online; clicked => { root.download-action(0); } }
                    if root.collector-active: IconButton { label: "Download track"; icon: @image-url("icons/download-track.svg"); enabled: !root.collector-busy && root.collector-online && root.selected-track >= 0; clicked => { root.download-action(6); } }
                    if root.collector-active: IconButton { label: "Remove download"; icon: @image-url("icons/remove-download.svg"); clicked => { root.download-action(1); } }
                    if !root.wide: Rectangle { horizontal-stretch: 1; }
                    if !root.wide: IconButton { label: "Home"; icon: @image-url("icons/home.svg"); clicked => { root.home = true; keyboard.focus(); } }
                }
                if !root.artist-view: HorizontalLayout {
                    spacing: 0px;
                    for label[i] in ["Tracks", "Up next (" + root.queued.length + ")"] : tab := FocusScope {
                        height: 34px;
                        accessible-role: AccessibleRole.tab;
                        accessible-label: label + (root.show-queue == (i == 1) ? ", selected" : "");
                        key-pressed(event) => {
                            if (event.text == " " || event.text == Key.Return) { root.show-queue = i == 1; return accept; }
                            if (event.text == Key.LeftArrow || event.text == Key.RightArrow) { root.show-queue = !root.show-queue; return accept; }
                            return reject;
                        }
                        accessible-action-default => { root.show-queue = i == 1; }
                        Text { text: label; color: root.show-queue == (i == 1) ? Theme.text : Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                        Rectangle { y: parent.height - 2px; height: 2px; width: 100%; background: root.show-queue == (i == 1) ? Theme.accent : Theme.hover; }
                        TouchArea { clicked => { root.show-queue = i == 1; tab.focus(); } }
                    }
                }
                if !root.show-queue && !root.artist-view: ListView {
                    accessible-label: "Album tracks";
                    viewport-y <=> root.track-y;
                        min-height: 0px; preferred-height: 0px; vertical-stretch: 1;
                    for track[i] in root.tracks: TrackItem {
                        track: track; text-scale: root.text-scale; tap-to-play: root.tap-to-play;
                        selected: i == root.selected-track; current: i == root.active-track;
                        select => { root.selected-track = i; root.album-track-selected(); keyboard.focus(); }
                        play => { root.play-track(i); keyboard.focus(); }
                        enqueue => { root.enqueue(i); }
                    }
                }
                if root.show-queue && !root.artist-view: VerticalLayout {
                    IconButton { label: "Clear up next"; icon: @image-url("icons/trash.svg"); clicked => { root.clear-queue(); } }
                    ListView {
                        min-height: 0px; preferred-height: 0px; vertical-stretch: 1;
                        for title in root.queued: Text { text: title; color: Theme.text; height: 34px; overflow: elide; }
                    }
                }
            }
        }
        Rectangle {
            height: 104px * root.text-scale;
            background: Theme.transport; border-radius: 9px;
            VerticalLayout {
                padding: 8px; spacing: 4px;
                HorizontalLayout {
                    spacing: 10px;
                    if root.short && !root.home && !root.settings && !root.lists-open: IconButton { label: "Home"; icon: @image-url("icons/home.svg"); button-size: 40px; clicked => { root.home = true; keyboard.focus(); } }
                    TransportButton { icon: @image-url("icons/previous.svg"); label: "Previous track"; width: 40px; clicked => { root.previous(); } }
                    TransportButton {
                        width: 48px; height: 40px;
                        primary: true;
                        icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                        label: root.playing ? "Pause" : "Play";
                        clicked => { root.toggle-play(); }
                    }
                    TransportButton { icon: @image-url("icons/next.svg"); label: "Next track"; width: 40px; clicked => { root.next(); } }
                    VerticalLayout {
                        Text { text: root.now-title; color: Theme.text; overflow: elide; font-weight: 600; }
                        Text { text: root.now-artist; color: Theme.muted; overflow: elide; font-size: 12px * root.text-scale; }
                    }
                    if root.wide: Rectangle {
                        width: 68px; background: Theme.divider;
                        Rectangle { y: parent.height * (1 - root.level); height: parent.height * root.level; width: parent.width; background: Theme.accent; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.elapsed; color: Theme.muted; width: 40px; vertical-alignment: center; }
                    playhead := TransportSeek { position <=> root.progress; seek(v) => { root.seek(v); } }
                    Text { text: root.duration; color: Theme.muted; width: 40px; vertical-alignment: center; }
                }
                if root.scanning: Rectangle {
                    height: 3px; background: Theme.hover;
                    Rectangle { height: 100%; width: parent.width * root.scan-progress; background: Theme.accent; }
                }
                HorizontalLayout {
                    height: 18px * root.text-scale; spacing: 6px;
                    Text { text: root.status; color: Theme.muted; overflow: elide; vertical-alignment: center; font-size: 11px * root.text-scale; accessible-label: "Playback status"; horizontal-stretch: 1; }
                    ConnectionIndicator { kind: root.connection-kind; text-scale: root.text-scale; available-width: parent.width; }
                }
            }
        }

    }
    }
    error-dialog := ErrorDialog {
        visible: root.error-message != "";
        x: root.safe-area-insets.left; y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        title: root.error-title; message: root.error-message;
        dismissed => { root.error-message = ""; }
    }
}
