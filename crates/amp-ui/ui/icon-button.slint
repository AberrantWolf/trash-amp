import { Theme } from "theme.slint";

// Native touch hosts disable hover hints; accessible names are always present.
export global ButtonHints {
    in-out property <bool> hover-tooltips: true;
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <length> button-size: 44px;
    callback clicked();
    width: root.button-size; height: root.button-size;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: 6px;
    background: !root.enabled ? Theme.surface : root.primary ? Theme.accent
        : (pointer.has-hover || pointer.pressed ? Theme.hover : Theme.raised);
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.accent : (root.primary && root.enabled ? Theme.accent : Theme.border);
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    focus := FocusScope {
        width: 100%; height: 100%; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    Image {
        source: root.icon;
        colorize: root.primary ? (Theme.dark ? #242321 : #ffffff) : Theme.text;
        width: root.primary ? 24px : 20px; height: self.width;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        opacity: !root.enabled ? 0.35 : pointer.pressed ? 0.65 : 1;
        accessible-role: none;
    }
    pointer := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
    // Remove the hover observer entirely on touch hosts (empty text still opens a popup).
    if ButtonHints.hover-tooltips && root.enabled: Rectangle {
        width: 100%; height: 100%;
        Tooltip {
            Rectangle {
                background: Theme.surface; border-radius: 5px;
                border-width: 1px; border-color: Theme.border;
                HorizontalLayout {
                    padding: 8px;
                    hint := Text { text: root.label; color: Theme.text; max-width: 300px; wrap: word-wrap; }
                }
            }
        }
    }
}
