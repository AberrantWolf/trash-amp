import { Theme } from "theme.slint";
import { IconButton } from "icon-button.slint";
export struct TrackRow { title: string, status: string, scan-status: string, duration: string, number: string }
export component TrackItem inherits Rectangle {
    in property <TrackRow> track;
    in property <float> text-scale: 1;
    in property <bool> selected;
    in property <bool> current;
    in property <bool> tap-to-play;
    callback select(); callback play(); callback enqueue();
    height: (root.track.status != "" && root.track.scan-status != "" ? 60px : 48px) * root.text-scale;
    accessible-role: list-item;
    accessible-label: root.track.title + (root.track.status != "" ? ", " + root.track.status : "") + (root.track.scan-status != "" ? ", " + root.track.scan-status : "") + (root.current ? ", current track" : "");
    accessible-action-default => { root.play(); }
    background: root.selected ? Theme.selection : (row.has-hover || play-touch.has-hover ? Theme.hover : transparent);
    row := TouchArea {
        x: 42px; width: parent.width - 90px;
        clicked => { root.select(); if root.tap-to-play { root.play(); } }
        double-clicked => { if !root.tap-to-play { root.play(); } }
    }
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 36px;
            Text { visible: !row.has-hover && !play-touch.has-hover; text: root.current ? "▶" : root.track.number; color: root.current ? Theme.accent : Theme.muted; vertical-alignment: center; horizontal-alignment: center; }
            Image { visible: row.has-hover || play-touch.has-hover; source: @image-url("icons/play.svg"); colorize: Theme.text; width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            play-touch := TouchArea {
                accessible-role: button; accessible-label: "Play " + root.track.title;
                accessible-action-default => { root.play(); }
                clicked => { root.play(); }
            }
        }
        VerticalLayout {
            alignment: center; spacing: 1px;
            Text { text: root.track.title; color: Theme.text; font-size: 14px * root.text-scale; overflow: elide; vertical-alignment: center; }
            if root.track.status != "": Text { text: root.track.status; color: Theme.muted; font-size: 11px * root.text-scale; overflow: elide; }
            if root.track.scan-status != "": Text { text: root.track.scan-status; color: Theme.muted; font-size: 11px * root.text-scale; overflow: elide; }
        }
        Text { text: root.track.duration; color: Theme.muted; width: 44px; vertical-alignment: center; }
        IconButton { label: "Add " + root.track.title + " to up next"; icon: @image-url("icons/queue.svg"); clicked => { root.enqueue(); } }
    }
}
