<!doctype html>
<html lang="en"><meta charset="utf-8"><title>Trash Amp dependency notices</title>
<style>body{max-width:900px;margin:40px auto;padding:0 24px;font:16px system-ui}pre{white-space:pre-wrap}h2{margin-top:48px}</style>
<h1>Trash Amp dependency notices</h1>
<p>Application source is MIT licensed. These notices cover its runtime dependencies.
Additional native library notices are included in the accompanying native-licenses directory.</p>
{{#each licenses}}
<h2>{{name}}</h2>
<ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}</ul>
<pre>{{text}}</pre>
{{/each}}
</html>
